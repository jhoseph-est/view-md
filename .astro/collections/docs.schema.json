{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "enum": [
        "minimalista",
        "academico",
        "moderno",
        "oscuro"
      ]
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orden": {
      "type": "number"
    },
    "slides": {
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "curso": {
      "type": "string"
    },
    "ciclo": {
      "type": [
        "string",
        "number"
      ]
    },
    "dificultad": {
      "type": "string"
    },
    "tiempoLectura": {
      "type": "string"
    },
    "referencia": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}