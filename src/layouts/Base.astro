---
// src/layouts/Base.astro
import '../styles/base.css';
import ActivityBar from '../components/ActivityBar.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { ClientRouter } from 'astro:transitions';
import GlobalModal from '../components/GlobalModal.astro';
import GraphModal from '../components/GraphModal.astro';

const {
  title,
  headings = [],
  frontmatter = {},
  isLanding = false
} = Astro.props;

// Prioridad absoluta al YAML si define theme
const temaDoc = frontmatter.theme || '';
const hasSlides = frontmatter.slides === true ? 'true' : 'false';
---

<!DOCTYPE html>
<html lang="es" data-tema-doc={temaDoc} data-has-slides={hasSlides}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      (function () {
        const html = document.documentElement;
        
        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        
        // Prioridad: YAML del documento > preferencia guardada > 'moderno'
        const temaForzado = html.getAttribute('data-tema-doc');
        const estilo = temaForzado || localStorage.getItem('pref-estilo') || 'moderno';
        
        html.setAttribute('data-modo', modo);
        html.setAttribute('data-estilo', estilo);
        html.setAttribute('data-texto', texto);

        const leftOpen = localStorage.getItem('wiki-left-open') === 'true';
        const showToc = localStorage.getItem('wiki-show-toc') === 'true';
        const showMeta = localStorage.getItem('wiki-show-meta') === 'true';
        const activePane = localStorage.getItem('wiki-active-pane') || 'pane-explorer';

        if (!leftOpen) {
          html.classList.add('no-left-panel');
        } else {
          html.setAttribute('data-active-pane', activePane);
        }

        if (!showToc) html.classList.add('no-toc');
        if (!showMeta) html.classList.add('no-meta');

        document.addEventListener('astro:before-swap', (ev) => {
          // Si el navegador sigue en Fullscreen, mantener zen-active en el nuevo grid
          if (document.fullscreenElement) {
            const nextGrid = ev.newDocument.getElementById('main-grid');
            if (nextGrid) nextGrid.classList.add('zen-active');
          }

          const m = localStorage.getItem('pref-modo') || 'oscuro';
          const t = localStorage.getItem('pref-texto') || 'estandar';
          
          const nuevoDoc = ev.newDocument.documentElement;
          const nuevoTemaForzado = nuevoDoc.getAttribute('data-tema-doc');
          const nuevoEstilo = nuevoTemaForzado || localStorage.getItem('pref-estilo') || 'moderno';
          const incomingSlides = nuevoDoc.getAttribute('data-has-slides') || 'false';
          
          nuevoDoc.setAttribute('data-modo', m);
          nuevoDoc.setAttribute('data-estilo', nuevoEstilo);
          nuevoDoc.setAttribute('data-texto', t);
          nuevoDoc.setAttribute('data-has-slides', incomingSlides);
          
          const lOpen = localStorage.getItem('wiki-left-open') === 'true';
          const sToc = localStorage.getItem('wiki-show-toc') === 'true';
          const sMeta = localStorage.getItem('wiki-show-meta') === 'true';
          const aPane = localStorage.getItem('wiki-active-pane') || 'pane-explorer';

          if (!lOpen) {
            nuevoDoc.classList.add('no-left-panel');
          } else {
            nuevoDoc.setAttribute('data-active-pane', aPane);
          }
          if (!sToc) nuevoDoc.classList.add('no-toc');
          if (!sMeta) nuevoDoc.classList.add('no-meta');
        });
      })();
    </script>
    <link 
      rel="stylesheet" 
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
      crossorigin="anonymous" 
    />
  </head>
  <body>
    <div class={`layout-grid ${isLanding ? 'no-left-panel no-toc no-meta' : ''}`} id="main-grid">
       <ActivityBar />
       <LeftSidebar />

       <!-- ÁREA CENTRAL DE LECTURA -->
       <main class="main-content" data-pagefind-ignore id="main-scroll-container">
         <!-- Botón flotante para salir del Modo Zen -->
         <button id="btn-exit-zen" class="zen-exit-btn" title="Salir de Modo Zen (Esc o Alt+Z)">
           <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <line x1="18" y1="6" x2="6" y2="18"></line>
             <line x1="6" y1="6" x2="18" y2="18"></line>
           </svg>
           <span>Salir Zen (Esc)</span>
         </button>

         <div class="content-wrapper">
           {!isLanding && <Breadcrumbs title={title} />}
           <slot />
         </div>
       </main>

       <RightSidebar headings={headings} frontmatter={frontmatter} />
    </div>
     
    <GlobalModal />
    <GraphModal />

    <!-- ==========================================================
       BARRA DE NAVEGACIÓN INFERIOR (MÓVIL < 768px)
       ========================================================== -->
    <nav class="mobile-bottom-bar" id="mobile-bottom-bar" aria-label="Navegación Móvil">
      <button class="m-btn active" data-drawer="m-drawer-explorer" title="Explorador">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
        <span>Explorar</span>
      </button>
      <button class="m-btn" data-drawer="m-drawer-search" title="Buscar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span>Buscar</span>
      </button>
      <button class="m-btn" data-drawer="m-drawer-toc" title="Índice">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="21" x2="3" y1="6" y2="6"/><line x1="15" x2="3" y1="12" y2="12"/><line x1="17" x2="3" y1="18" y2="18"/></svg>
        <span>Índice</span>
      </button>
      <button class="m-btn" data-drawer="m-drawer-meta" title="Metadatos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        <span>Meta</span>
      </button>
      <button class="m-btn" data-drawer="m-drawer-settings" title="Ajustes">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        <span>Ajustes</span>
      </button>
      <button class="m-btn" id="m-act-zen" title="Modo Zen">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" x2="14" y1="3" y2="10"/><line x1="3" x2="10" y1="21" y2="14"/></svg>
        <span>Zen</span>
      </button>
    </nav>

    <!-- Fondo oscuro -->
    <div class="mobile-drawer-backdrop" id="mobile-backdrop"></div>

    <!-- CAJONES MÓVILES -->
    <div class="mobile-drawer" id="m-drawer-explorer">
      <div class="drawer-handle"></div>
      <div class="drawer-header"><h3>Explorador de Archivos</h3></div>
      <div class="drawer-body" id="mobile-explorer-content"></div>
    </div>

    <div class="mobile-drawer" id="m-drawer-search">
      <div class="drawer-handle"></div>
      <div class="drawer-header"><h3>Buscar en el Repositorio</h3></div>
      <div class="drawer-body" id="mobile-search-content"></div>
    </div>

    <div class="mobile-drawer" id="m-drawer-toc">
      <div class="drawer-handle"></div>
      <div class="drawer-header"><h3>Índice del Documento</h3></div>
      <div class="drawer-body" id="mobile-toc-content"></div>
    </div>

    <div class="mobile-drawer" id="m-drawer-meta">
      <div class="drawer-handle"></div>
      <div class="drawer-header"><h3>Metadatos</h3></div>
      <div class="drawer-body" id="mobile-meta-content"></div>
    </div>

    <div class="mobile-drawer" id="m-drawer-settings">
      <div class="drawer-handle"></div>
      <div class="drawer-header"><h3>Configuración de Apariencia</h3></div>
      <div class="drawer-body" id="mobile-settings-content"></div>
    </div>
  
<script>
  import { renderMermaid } from '../utils/mermaidViewer';
  import { renderCallouts } from '../utils/callouts';

  declare global {
    interface Window {
      PagefindUI: any;
    }
  }

  function initializeApp() {
    renderCallouts();
    renderMermaid(false);

    const root = document.documentElement;
    const mainGrid = document.getElementById('main-grid');

    let isLeftOpen = localStorage.getItem('wiki-left-open') === 'true';
    let showToc = localStorage.getItem('wiki-show-toc') === 'true';
    let showMeta = localStorage.getItem('wiki-show-meta') === 'true';
    let activePane = localStorage.getItem('wiki-active-pane') || 'pane-explorer';

    let memLeft = localStorage.getItem('wiki-mem-left') === 'true';
    let memToc = localStorage.getItem('wiki-mem-toc') === 'true';
    let memMeta = localStorage.getItem('wiki-mem-meta') === 'true';

    const actToc = document.getElementById('act-toc');
    const actMeta = document.getElementById('act-meta');
    const actCollapse = document.getElementById('act-collapse');
    const actZen = document.getElementById('act-zen');
    const btnExitZen = document.getElementById('btn-exit-zen');
    const actExplorer = document.getElementById('act-explorer');
    const actSearch = document.getElementById('act-search');
    const actSettings = document.getElementById('act-settings');
    const actPrint = document.getElementById('act-print');
    const leftTitle = document.getElementById('left-panel-title');

    const actSlides = document.getElementById('act-slides') as HTMLAnchorElement | null;
    if (actSlides) {
      const currentDocPath = window.location.pathname.replace(/^\/docs\/?/, '').replace(/\/$/, '');
      actSlides.href = `/slides/${currentDocPath}`;
    }

    // ==========================================
    // GESTIÓN DE CAJONES Y NAVEGACIÓN MÓVIL (VISTA DIRECTA)
    // ==========================================
    const mButtons = document.querySelectorAll('.m-btn[data-drawer]');
    const drawers = document.querySelectorAll('.mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');
    const mActZen = document.getElementById('m-act-zen');

    if (mActZen) {
      mActZen.onclick = toggleZenMode;
    }

    // 1. Explorador Móvil
    const desktopExplorer = document.getElementById('pane-explorer');
    const mobileExplorerTarget = document.getElementById('mobile-explorer-content');
    if (desktopExplorer && mobileExplorerTarget && mobileExplorerTarget.innerHTML.trim() === '') {
      const clone = desktopExplorer.cloneNode(true) as HTMLElement;
      clone.style.display = 'flex';
      mobileExplorerTarget.appendChild(clone);
    }

    // 2. Buscador Móvil
    const mobileSearchTarget = document.getElementById('mobile-search-content');
    if (mobileSearchTarget && mobileSearchTarget.innerHTML.trim() === '') {
      mobileSearchTarget.innerHTML = `<div style="padding: 0.5rem 0;" id="mobile-pagefind-container"></div>`;
      if (window.PagefindUI) {
        new window.PagefindUI({ element: "#mobile-pagefind-container", showSubResults: true });
      }
    }

    // 3. Índice Móvil (TOC)
    const mobileTocTarget = document.getElementById('mobile-toc-content');
    const desktopTocBody = document.getElementById('toc-body') || document.querySelector('.toc-body');
    if (mobileTocTarget && mobileTocTarget.innerHTML.trim() === '') {
      if (desktopTocBody && desktopTocBody.innerHTML.trim() !== '') {
        const clone = desktopTocBody.cloneNode(true) as HTMLElement;
        mobileTocTarget.appendChild(clone);
      } else {
        mobileTocTarget.innerHTML = `<p class="empty-note">Esta página no contiene índice de encabezados.</p>`;
      }
    }

    // 4. Metadatos Móvil
    const mobileMetaTarget = document.getElementById('mobile-meta-content');
    const desktopMetaBody = document.querySelector('.bottom-meta .panel-body') || document.querySelector('.meta-body');
    if (mobileMetaTarget && mobileMetaTarget.innerHTML.trim() === '') {
      if (desktopMetaBody && desktopMetaBody.innerHTML.trim() !== '') {
        const clone = desktopMetaBody.cloneNode(true) as HTMLElement;
        mobileMetaTarget.appendChild(clone);
      } else {
        mobileMetaTarget.innerHTML = `<p class="empty-note">No hay metadatos disponibles para esta vista.</p>`;
      }
    }

    // 5. Ajustes Móvil (Movimiento real de nodos para preservar interactividad)
    const mobileSettingsTarget = document.getElementById('mobile-settings-content');
    const desktopSettings = document.getElementById('pane-settings');
    if (mobileSettingsTarget && desktopSettings && mobileSettingsTarget.innerHTML.trim() === '') {
      while (desktopSettings.firstChild) {
        mobileSettingsTarget.appendChild(desktopSettings.firstChild);
      }
      desktopSettings.style.display = 'none';
    }

    function closeAllDrawers() {
      drawers.forEach(d => d.classList.remove('open'));
      backdrop?.classList.remove('active');
      mButtons.forEach(b => b.classList.remove('active'));
    }

    mButtons.forEach(node => {
      const btn = node as HTMLElement;
      btn.onclick = () => {
        const drawerId = btn.getAttribute('data-drawer');
        const targetDrawer = drawerId ? document.getElementById(drawerId) : null;
        const isOpen = targetDrawer?.classList.contains('open');

        closeAllDrawers();

        if (!isOpen && targetDrawer) {
          targetDrawer.classList.add('open');
          backdrop?.classList.add('active');
          btn.classList.add('active');
        }
      };
    });

    backdrop?.addEventListener('click', closeAllDrawers);

    function syncUI(save = true) {
      root.classList.toggle('no-left-panel', !isLeftOpen);
      root.classList.toggle('no-toc', !showToc);
      root.classList.toggle('no-meta', !showMeta);

      if (isLeftOpen) {
        root.setAttribute('data-active-pane', activePane);
        if (leftTitle) {
          if (activePane === 'pane-explorer') leftTitle.textContent = 'EXPLORADOR';
          if (activePane === 'pane-search') {
            leftTitle.textContent = 'BUSCAR';
            initSearch();
          }
          if (activePane === 'pane-settings') leftTitle.textContent = 'AJUSTES';
        }
      } else {
        root.removeAttribute('data-active-pane');
      }

      const anyActive = isLeftOpen || showToc || showMeta;
      if (actCollapse) actCollapse.classList.toggle('active', anyActive);

      if (save) {
        localStorage.setItem('wiki-left-open', isLeftOpen.toString());
        localStorage.setItem('wiki-show-toc', showToc.toString());
        localStorage.setItem('wiki-show-meta', showMeta.toString());
        localStorage.setItem('wiki-active-pane', activePane);
      }
    }

    function initSearch() {
      const container = document.getElementById('inline-pagefind-container');
      if (container && container.innerHTML.trim() === '') {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: "#inline-pagefind-container", showSubResults: true });
        }
      }
      setTimeout(() => container?.querySelector('input')?.focus(), 80);
    }

    if (actCollapse) {
      actCollapse.onclick = () => {
        const anyActive = isLeftOpen || showToc || showMeta;
        if (anyActive) {
          memLeft = isLeftOpen;
          memToc = showToc;
          memMeta = showMeta;
          localStorage.setItem('wiki-mem-left', memLeft.toString());
          localStorage.setItem('wiki-mem-toc', memToc.toString());
          localStorage.setItem('wiki-mem-meta', memMeta.toString());

          isLeftOpen = false;
          showToc = false;
          showMeta = false;
        } else {
          if (!memLeft && !memToc && !memMeta) {
            isLeftOpen = true;
          } else {
            isLeftOpen = memLeft;
            showToc = memToc;
            showMeta = memMeta;
          }
        }
        syncUI();
      };
    }

    if (document.fullscreenElement && mainGrid) {
      mainGrid.classList.add('zen-active');
    }

    function toggleZenMode() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => {
          mainGrid?.classList.add('zen-active');
        }).catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    if (actZen) actZen.onclick = toggleZenMode;
    if (btnExitZen) {
      btnExitZen.onclick = () => {
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        } else {
          mainGrid?.classList.remove('zen-active');
        }
      };
    }

    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        mainGrid?.classList.remove('zen-active');
      } else {
        mainGrid?.classList.add('zen-active');
      }
    });

    if (actExplorer) {
      actExplorer.onclick = () => {
        if (isLeftOpen && activePane === 'pane-explorer') {
          isLeftOpen = false;
        } else {
          isLeftOpen = true;
          activePane = 'pane-explorer';
        }
        syncUI();
      };
    }

    if (actSearch) {
      actSearch.onclick = () => {
        if (isLeftOpen && activePane === 'pane-search') {
          isLeftOpen = false;
        } else {
          isLeftOpen = true;
          activePane = 'pane-search';
        }
        syncUI();
      };
    }

    if (actSettings) {
      actSettings.onclick = () => {
        if (isLeftOpen && activePane === 'pane-settings') {
          isLeftOpen = false;
        } else {
          isLeftOpen = true;
          activePane = 'pane-settings';
        }
        syncUI();
      };
    }

    if (actToc) actToc.onclick = () => { showToc = !showToc; syncUI(); };
    if (actMeta) actMeta.onclick = () => { showMeta = !showMeta; syncUI(); };
    if (actPrint) actPrint.onclick = () => { window.print(); };

    syncUI(false);
  }

  // Delegación de eventos global para garantizar control total de ajustes en Móvil y PC
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const settingBtn = target.closest('button[data-estilo], button[data-modo], button[data-texto], button[data-ancho], .theme-btn, .mode-btn, .text-btn');
    if (!settingBtn) return;

    const estilo = settingBtn.getAttribute('data-estilo');
    const modo = settingBtn.getAttribute('data-modo');
    const texto = settingBtn.getAttribute('data-texto');
    const ancho = settingBtn.getAttribute('data-ancho');

    const html = document.documentElement;

    if (estilo) {
      html.setAttribute('data-estilo', estilo);
      localStorage.setItem('pref-estilo', estilo);
      window.dispatchEvent(new Event('theme-changed'));
    }
    if (modo) {
      html.setAttribute('data-modo', modo);
      localStorage.setItem('pref-modo', modo);
      window.dispatchEvent(new Event('theme-changed'));
    }
    if (texto) {
      html.setAttribute('data-texto', texto);
      localStorage.setItem('pref-texto', texto);
    }
    if (ancho) {
      html.setAttribute('data-ancho', ancho);
      localStorage.setItem('pref-ancho', ancho);
    }
  });

  document.addEventListener('keydown', (e) => {
    const actCollapse = document.getElementById('act-collapse');
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
      e.preventDefault();
      actCollapse?.click();
    } else if (e.altKey && e.key.toLowerCase() === 'z') {
      e.preventDefault();
      const mainGrid = document.getElementById('main-grid');
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => mainGrid?.classList.add('zen-active')).catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }
  });

  window.addEventListener('theme-changed', () => {
    renderMermaid(true);
  });

  document.addEventListener('astro:page-load', initializeApp);
  document.addEventListener('astro:after-swap', initializeApp);
</script>
  </body>
</html>