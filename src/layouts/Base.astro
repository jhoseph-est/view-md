---
import '../styles/base.css';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions';
import GlobalModal from '../components/GlobalModal.astro';

const {
  title,
  headings = [],
  frontmatter = {},
  isLanding = false
} = Astro.props;

const estiloDoc = frontmatter.theme || 'moderno';
---

<!DOCTYPE html>
<html lang="es" data-estilo={estiloDoc}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      (function () {
        const html = document.documentElement;
        
        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        const ancho = localStorage.getItem('pref-ancho') || 'normal';
        html.setAttribute('data-modo', modo);
        html.setAttribute('data-texto', texto);
        html.setAttribute('data-ancho', ancho);

        // Lectura síncrona instantánea para evitar parpadeos en los paneles
        const leftOpen = localStorage.getItem('wiki-left-open') !== 'false';
        const showToc = localStorage.getItem('wiki-show-toc') !== 'false';
        const showMeta = localStorage.getItem('wiki-show-meta') !== 'false';

        if (!leftOpen) html.classList.add('no-left-panel');
        if (!showToc && !showMeta) html.classList.add('no-right-panel');
      })();
    </script>
    <link 
      rel="stylesheet" 
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
      crossorigin="anonymous" 
    />
  </head>
  <body>
    <div class={`layout-grid ${isLanding ? 'no-left-panel no-right-panel' : ''}`} id="main-grid">
       <!-- PANEL IZQUIERDO Y BARRA DE ACTIVIDAD -->
       <LeftSidebar />

       <!-- ÁREA CENTRAL DE LECTURA -->
       <main class="main-content" data-pagefind-ignore id="main-scroll-container">
         <div class="content-wrapper">
           <slot />
         </div>
       </main>

       <!-- PANEL DERECHO (ÍNDICE 2/3 Y METADATOS 1/3) -->
       <RightSidebar headings={headings} frontmatter={frontmatter} />
    </div>
     
    <GlobalModal />

    <script>
      declare global {
        interface Window {
          PagefindUI: any;
        }
      }

      function setupLayoutEngine() {
        const grid = document.getElementById('main-grid');
        if (!grid) return;

        let isLeftOpen = localStorage.getItem('wiki-left-open') !== 'false';
        let showToc = localStorage.getItem('wiki-show-toc') !== 'false';
        let showMeta = localStorage.getItem('wiki-show-meta') !== 'false';
        let memoryActivePane = localStorage.getItem('wiki-active-pane') || 'pane-explorer';

        const secToc = document.getElementById('sec-toc');
        const secMeta = document.getElementById('sec-meta');
        const actToc = document.getElementById('act-toc');
        const actMeta = document.getElementById('act-meta');
        const actCollapse = document.getElementById('act-collapse');
        const actExplorer = document.getElementById('act-explorer');
        const actSearch = document.getElementById('act-search');
        const actSettings = document.getElementById('act-settings');
        const leftTitle = document.getElementById('left-panel-title');
        const leftPanes = document.querySelectorAll('.l-pane');

        if (isLeftOpen) {
          grid.classList.remove('no-left-panel');
          document.documentElement.classList.remove('no-left-panel');
          activatePaneSilently(memoryActivePane);
        } else {
          grid.classList.add('no-left-panel');
          document.documentElement.classList.add('no-left-panel');
          if (actExplorer) actExplorer.classList.remove('active');
          if (actSearch) actSearch.classList.remove('active');
          if (actSettings) actSettings.classList.remove('active');
        }

        updateRightPanel(false);

        function syncCollapseButtonState() {
          if (!grid) return;
          const leftOpen = !grid.classList.contains('no-left-panel');
          const rightClosed = grid.classList.contains('no-right-panel');
          if (actCollapse) {
            actCollapse.classList.toggle('active', leftOpen || !rightClosed);
          }
        }

        function updateRightPanel(save = true) {
          if (!secToc || !secMeta || !grid) return;

          if (showToc && showMeta) {
            grid.classList.remove('no-right-panel');
            document.documentElement.classList.remove('no-right-panel');
            secToc.style.display = 'flex';
            secMeta.style.display = 'flex';
            secToc.classList.remove('fill-all');
            secMeta.classList.remove('fill-all');
          } else if (showToc && !showMeta) {
            grid.classList.remove('no-right-panel');
            document.documentElement.classList.remove('no-right-panel');
            secToc.style.display = 'flex';
            secMeta.style.display = 'none';
            secToc.classList.add('fill-all');
          } else if (!showToc && showMeta) {
            grid.classList.remove('no-right-panel');
            document.documentElement.classList.remove('no-right-panel');
            secToc.style.display = 'none';
            secMeta.style.display = 'flex';
            secMeta.classList.add('fill-all');
          } else {
            grid.classList.add('no-right-panel');
            document.documentElement.classList.add('no-right-panel');
          }

          const isRightClosed = grid.classList.contains('no-right-panel');
          if (actToc) actToc.classList.toggle('active', !isRightClosed && showToc);
          if (actMeta) actMeta.classList.toggle('active', !isRightClosed && showMeta);

          if (save) {
            localStorage.setItem('wiki-show-toc', showToc.toString());
            localStorage.setItem('wiki-show-meta', showMeta.toString());
          }
          syncCollapseButtonState();
        }

        function activatePaneSilently(paneId: string) {
          leftPanes.forEach(p => p.classList.remove('active'));
          if (actExplorer) actExplorer.classList.remove('active');
          if (actSearch) actSearch.classList.remove('active');
          if (actSettings) actSettings.classList.remove('active');

          const target = document.getElementById(paneId);
          target?.classList.add('active');

          if (paneId === 'pane-explorer') {
            if (actExplorer) actExplorer.classList.add('active');
            if (leftTitle) leftTitle.textContent = 'EXPLORADOR';
          } else if (paneId === 'pane-search') {
            if (actSearch) actSearch.classList.add('active');
            if (leftTitle) leftTitle.textContent = 'BUSCAR';
            initPagefind();
          } else if (paneId === 'pane-settings') {
            if (actSettings) actSettings.classList.add('active');
            if (leftTitle) leftTitle.textContent = 'AJUSTES';
          }
        }

        function openLeftPane(paneId: string, btn: HTMLElement | null) {
          if (!grid) return;
          const isClosed = grid.classList.contains('no-left-panel');
          const isCurrent = document.getElementById(paneId)?.classList.contains('active');

          if (!isClosed && isCurrent) {
            grid.classList.add('no-left-panel');
            document.documentElement.classList.add('no-left-panel');
            if (btn) btn.classList.remove('active');
            localStorage.setItem('wiki-left-open', 'false');
          } else {
            grid.classList.remove('no-left-panel');
            document.documentElement.classList.remove('no-left-panel');
            activatePaneSilently(paneId);
            localStorage.setItem('wiki-left-open', 'true');
            localStorage.setItem('wiki-active-pane', paneId);
          }
          syncCollapseButtonState();
        }

        function initPagefind() {
          const container = document.getElementById('inline-pagefind-container');
          if (container && container.innerHTML.trim() === '') {
            if (window.PagefindUI) {
              new window.PagefindUI({ element: "#inline-pagefind-container", showSubResults: true });
            }
          }
          setTimeout(() => container?.querySelector('input')?.focus(), 80);
        }

        // Colapso Maestro guardando estado exacto
        if (actCollapse) {
          actCollapse.onclick = () => {
            if (!grid) return;
            const leftOpen = !grid.classList.contains('no-left-panel');
            const rightClosed = grid.classList.contains('no-right-panel');
            const anyOpen = leftOpen || !rightClosed;

            if (anyOpen) {
              grid.classList.add('no-left-panel', 'no-right-panel');
              document.documentElement.classList.add('no-left-panel', 'no-right-panel');
              localStorage.setItem('wiki-left-open', 'false');
              localStorage.setItem('wiki-show-toc', 'false');
              localStorage.setItem('wiki-show-meta', 'false');
              
              if (actExplorer) actExplorer.classList.remove('active');
              if (actSearch) actSearch.classList.remove('active');
              if (actSettings) actSettings.classList.remove('active');
              if (actToc) actToc.classList.remove('active');
              if (actMeta) actMeta.classList.remove('active');
              if (actCollapse) actCollapse.classList.remove('active');
            } else {
              grid.classList.remove('no-left-panel', 'no-right-panel');
              document.documentElement.classList.remove('no-left-panel', 'no-right-panel');
              localStorage.setItem('wiki-left-open', 'true');
              localStorage.setItem('wiki-show-toc', 'true');
              localStorage.setItem('wiki-show-meta', 'true');
              showToc = true;
              showMeta = true;
              openLeftPane(memoryActivePane, actExplorer);
              updateRightPanel();
            }
          };
        }

        if (actExplorer) actExplorer.onclick = () => openLeftPane('pane-explorer', actExplorer);
        if (actSearch) actSearch.onclick = () => { openLeftPane('pane-search', actSearch); initPagefind(); };
        if (actSettings) actSettings.onclick = () => openLeftPane('pane-settings', actSettings);

        if (actToc) {
          actToc.onclick = () => {
            if (!grid) return;
            const rightClosed = grid.classList.contains('no-right-panel');
            if (rightClosed) {
              grid.classList.remove('no-right-panel');
              document.documentElement.classList.remove('no-right-panel');
              showToc = true;
            } else {
              showToc = !showToc;
              if (!showToc && !showMeta) {
                grid.classList.add('no-right-panel');
                document.documentElement.classList.add('no-right-panel');
              }
            }
            updateRightPanel();
          };
        }

        if (actMeta) {
          actMeta.onclick = () => {
            if (!grid) return;
            const rightClosed = grid.classList.contains('no-right-panel');
            if (rightClosed) {
              grid.classList.remove('no-right-panel');
              document.documentElement.classList.remove('no-right-panel');
              showMeta = true;
            } else {
              showMeta = !showMeta;
              if (!showToc && !showMeta) {
                grid.classList.add('no-right-panel');
                document.documentElement.classList.add('no-right-panel');
              }
            }
            updateRightPanel();
          };
        }

        document.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
            e.preventDefault();
            actCollapse?.click();
          }
        });
      }

      document.addEventListener('astro:page-load', setupLayoutEngine);
    </script>
  </body>
</html>