---
// src/pages/preview/[...id].astro
import { getCollection, render } from 'astro:content';
import { generateDocPaths } from '../../utils/fileTree';
import ReportCover from '../../components/ReportCover.astro';
import ReportToc from '../../components/ReportToc.astro';
import '../../styles/base.css';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  return generateDocPaths(allDocs);
}

const props = Astro.props;
if (props.type !== 'file') {
  return Astro.redirect('/docs/explorar');
}

const rendered = await render(props.doc);
const { Content, headings } = rendered;
const docData = props.doc.data;

const estiloInicial = docData.theme || (docData.tipo === 'informe' ? 'informe' : 'moderno');
const tieneCoverInicial = docData.theme === 'informe' || docData.tipo === 'informe';
const tieneTocInicial = docData.mostrarIndice !== false;
---

<!DOCTYPE html>
<html lang="es" data-modo="claro" data-estilo={estiloInicial}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vista Previa Editorial - {docData.title}</title>

    <!-- Paged.js Script Manual (Sin polyfill automático) -->
    <script src="https://unpkg.com/pagedjs/dist/paged.polyfill.js" is:inline></script>

    <style is:global>
      /* 1. RESET AISLADO DE LA PANTALLA */
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        overflow: hidden !important;
        background-color: #1a1d21 !important;
        font-family: system-ui, -apple-system, sans-serif !important;
      }

      .preview-app-container {
        display: flex;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
      }

      /* 2. PANEL LATERAL FIJO */
      .sidebar-panel {
        width: 320px;
        min-width: 320px;
        height: 100vh;
        background-color: #121519;
        border-right: 1px solid #282f3a;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        z-index: 100;
      }

      .panel-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #282f3a;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .panel-header h2 {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        margin: 0;
        color: #a78bfa;
        text-transform: uppercase;
      }

      .btn-close {
        background: #202630;
        border: 1px solid #333d4d;
        color: #cbd5e1;
        padding: 0.35rem 0.65rem;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
      }

      .panel-content {
        flex: 1;
        overflow-y: auto;
        padding: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        box-sizing: border-box;
      }

      .ctrl-block {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
      }

      .ctrl-block label {
        font-size: 0.72rem;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        display: flex;
        justify-content: space-between;
      }

      .ctrl-block select {
        background-color: #0b0d10;
        border: 1px solid #282f3a;
        color: #f1f5f9;
        padding: 0.5rem;
        border-radius: 6px;
        font-size: 0.85rem;
        width: 100%;
        box-sizing: border-box;
      }

      .ctrl-block input[type="range"] {
        accent-color: #8b5cf6;
        width: 100%;
        margin: 0.2rem 0;
      }

      .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #cbd5e1;
      }

      .toggle-row input[type="checkbox"] {
        accent-color: #8b5cf6;
        cursor: pointer;
        width: 16px;
        height: 16px;
      }

      .panel-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid #282f3a;
        background: #0d0f13;
      }

      .btn-export {
        width: 100%;
        background: #8b5cf6;
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }

      .btn-export:hover {
        background: #7c3aed;
      }

      /* 3. LIENZO VIRTUAL PARA HOJAS PAGED.JS */
      .viewport-canvas {
        flex: 1;
        height: 100vh;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 3rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #1a1d21;
        box-sizing: border-box;
      }

      /* Contenedor fuente oculto: Paged.js lee de aquí y genera las hojas en #render-output */
      #paged-source {
        display: none;
      }

      /* 4. HOJAS GENERADAS AUTOMÁTICAMENTE POR PAGED.JS */
      .pagedjs_pages {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2.5rem;
        margin-bottom: 4rem;
      }

      .pagedjs_page {
        background: #ffffff !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5) !important;
        box-sizing: border-box;
      }

      .pagedjs_pagebox {
        color: #0f172a !important;
      }

      .pagedjs_pagebox * {
        color: #0f172a !important;
      }

      .pagedjs_pagebox p {
        text-align: justify;
        margin-bottom: 0.85rem;
      }

      .pagedjs_pagebox table {
        width: 100% !important;
        border-collapse: collapse !important;
        margin: 1.5rem 0 !important;
        border-top: 1.5pt solid #000000 !important;
        border-bottom: 1.5pt solid #000000 !important;
      }

      .pagedjs_pagebox th {
        border-bottom: 1pt solid #000000 !important;
        padding: 0.45rem 0.6rem !important;
        font-weight: 700 !important;
      }

      .pagedjs_pagebox td {
        border: none !important;
        padding: 0.45rem 0.6rem !important;
      }

      /* Saltos de página explícitos para Carátula e Índice */
      .page-cover {
        break-after: page;
        page-break-after: always;
      }

      .page-toc {
        break-after: page;
        page-break-after: always;
      }

      .pagedjs_pagebox hr {
        break-before: page;
        page-break-before: always;
        visibility: hidden;
        height: 0;
        margin: 0;
        border: none;
      }

      .is-hidden {
        display: none !important;
      }

      /* 5. IMPRESIÓN FÍSICA */
      @media print {
        body {
          background: transparent !important;
          overflow: visible !important;
          height: auto !important;
        }

        .sidebar-panel {
          display: none !important;
        }

        .viewport-canvas {
          padding: 0 !important;
          background: transparent !important;
          overflow: visible !important;
          height: auto !important;
        }

        .pagedjs_pages {
          gap: 0 !important;
          margin: 0 !important;
        }

        .pagedjs_page {
          box-shadow: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="preview-app-container">
      <!-- BARRA LATERAL -->
      <aside class="sidebar-panel">
        <div class="panel-header">
          <h2>Ajustes de Impresión</h2>
          <button class="btn-close" onclick="window.close()">✕ Cerrar</button>
        </div>

        <div class="panel-content">
          <div class="ctrl-block">
            <label>Estilo / Formato Base</label>
            <select id="sel-estilo">
              <option value="informe">Informe APA 7 (Formal)</option>
              <option value="academico">Académico (Sepia / Serif)</option>
              <option value="moderno">Moderno (Ingeniería / Sans)</option>
              <option value="minimalista">Minimalista (Monospace)</option>
            </select>
          </div>

          <hr style="border:0; border-top: 1px solid #242a34; margin: 0;" />

          <div class="ctrl-block">
            <label>Estructura</label>
            <div class="toggle-row">
              <span>Incluir Carátula</span>
              <input type="checkbox" id="chk-cover" checked={tieneCoverInicial} />
            </div>
            <div class="toggle-row">
              <span>Incluir Índice (TOC)</span>
              <input type="checkbox" id="chk-toc" checked={tieneTocInicial} />
            </div>
          </div>

          <div class="ctrl-block">
            <label>Margen Sup / Inf: <span id="lbl-margin-v">2.54 cm</span></label>
            <input type="range" id="rng-margin-v" min="1.0" max="3.5" step="0.1" value="2.54" />
          </div>

          <div class="ctrl-block">
            <label>Margen Izq / Der: <span id="lbl-margin-h">2.54 cm</span></label>
            <input type="range" id="rng-margin-h" min="1.0" max="3.5" step="0.1" value="2.54" />
          </div>

          <div class="ctrl-block">
            <label>Familia Tipográfica</label>
            <select id="sel-font">
              <option value="'Times New Roman', Times, serif">Times New Roman (APA)</option>
              <option value="Georgia, Cambria, serif">Georgia (Académico)</option>
              <option value="system-ui, -apple-system, sans-serif">Sans-Serif (Moderno)</option>
              <option value="'Fira Code', ui-monospace, monospace">Fira Code (Técnico)</option>
            </select>
          </div>

          <div class="ctrl-block">
            <label>Tamaño Texto: <span id="lbl-font-size">11.5 pt</span></label>
            <input type="range" id="rng-font-size" min="9" max="14" step="0.5" value="11.5" />
          </div>

          <div class="ctrl-block">
            <label>Interlineado: <span id="lbl-line-height">1.7</span></label>
            <input type="range" id="rng-line-height" min="1.1" max="2.2" step="0.1" value="1.7" />
          </div>

          <div class="ctrl-block">
            <label>Sangría 1ª Línea: <span id="lbl-indent">1.27 cm</span></label>
            <input type="range" id="rng-indent" min="0" max="2.5" step="0.1" value="1.27" />
          </div>
        </div>

        <div class="panel-footer">
          <button class="btn-export" onclick="window.print()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect width="12" height="8" x="6" y="14"></rect>
            </svg>
            <span>Imprimir / Exportar PDF</span>
          </button>
        </div>
      </aside>

      <!-- LIENZO DE PAGINACIÓN -->
      <main class="viewport-canvas">
        <!-- Destino donde Paged.js inyectará las páginas A4 físicas -->
        <div id="render-output"></div>

        <!-- Fuente original leída por Paged.js -->
        <div id="paged-source">
          <div class={`page-cover ${!tieneCoverInicial ? 'is-hidden' : ''}`} id="sec-cover">
            <ReportCover data={docData} />
          </div>

          <div class={`page-toc ${!tieneTocInicial ? 'is-hidden' : ''}`} id="sec-toc">
            <ReportToc headings={headings} />
          </div>

          <article class="markdown-body">
            <Content />
          </article>
        </div>
      </main>
    </div>

    <!-- SCRIPT CONTROLADOR DE PAGED.JS -->
    <script>
      import { renderMermaid } from '../../utils/mermaidViewer';

      declare global {
        interface Window {
          Paged: any;
        }
      }

      document.addEventListener('DOMContentLoaded', async () => {
        // 1. Renderizar diagramas antes del corte de hojas
        await renderMermaid(false, '#paged-source');

        const sourceEl = document.getElementById('paged-source');
        const outputEl = document.getElementById('render-output');

        let isRendering = false;

        // Función que invoca el motor de Paged.js de forma segura
        async function runPagination() {
          if (isRendering || !sourceEl || !outputEl) return;
          isRendering = true;

          outputEl.innerHTML = '<div style="color: #94a3b8; padding: 2rem;">Generando páginas...</div>';

          // Clonar contenido limpio
          const clone = sourceEl.cloneNode(true) as HTMLElement;
          clone.style.display = 'block';

          // Esperar a que Paged.js esté listo en window
          const pagedEngine = new window.Paged.Previewer();

          outputEl.innerHTML = '';
          await pagedEngine.preview(clone, [], outputEl);

          isRendering = false;
        }

        // Ejecutar paginado inicial
        setTimeout(runPagination, 200);

        // Controladores de la barra lateral con recálculo
        let debounceTimer: any = null;
        function updateAndRepaginate() {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(runPagination, 300);
        }

        document.getElementById('chk-cover')?.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          document.getElementById('sec-cover')?.classList.toggle('is-hidden', !target.checked);
          updateAndRepaginate();
        });

        document.getElementById('chk-toc')?.addEventListener('change', (e) => {
          const target = e.target as HTMLInputElement;
          document.getElementById('sec-toc')?.classList.toggle('is-hidden', !target.checked);
          updateAndRepaginate();
        });

        document.getElementById('rng-margin-v')?.addEventListener('input', (e) => {
          const val = (e.target as HTMLInputElement).value;
          document.documentElement.style.setProperty('--dyn-margin-v', `${val}cm`);
          document.getElementById('lbl-margin-v')!.textContent = `${val} cm`;
        });
        document.getElementById('rng-margin-v')?.addEventListener('change', updateAndRepaginate);

        document.getElementById('rng-margin-h')?.addEventListener('input', (e) => {
          const val = (e.target as HTMLInputElement).value;
          document.documentElement.style.setProperty('--dyn-margin-h', `${val}cm`);
          document.getElementById('lbl-margin-h')!.textContent = `${val} cm`;
        });
        document.getElementById('rng-margin-h')?.addEventListener('change', updateAndRepaginate);

        document.getElementById('rng-font-size')?.addEventListener('input', (e) => {
          const val = (e.target as HTMLInputElement).value;
          document.documentElement.style.setProperty('--dyn-font-size', `${val}pt`);
          document.getElementById('lbl-font-size')!.textContent = `${val} pt`;
        });
        document.getElementById('rng-font-size')?.addEventListener('change', updateAndRepaginate);
      });
    </script>
  </body>
</html>