---
// src/pages/docs/[...id].astro
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GraphModal from '../../components/GraphModal.astro';
import FolderView from '../../components/FolderView.astro';
import { formatName, generateDocPaths } from '../../utils/fileTree';
import DocReportHeader from '../../components/DocReportHeader.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  return generateDocPaths(allDocs);
}

const props = Astro.props;

let Content: any;
let headings: any[] = [];
let breadcrumbs: string[] = [];
let title = "";
let frontmatterConExtra = {};
let normalizedDocId = "";
let rawBody = "";

if (props.type === 'file') {
  rawBody = props.doc.body || '';
  const rendered = await render(props.doc);
  Content = rendered.Content;
  headings = rendered.headings;
  normalizedDocId = props.doc.id.replace(/\\/g, '/');
  breadcrumbs = normalizedDocId.split('/').slice(0, -1);
  const words = props.doc.body ? props.doc.body.split(/\s+/).length : 0;
  const readingTime = Math.max(1, Math.ceil(words / 200));
  frontmatterConExtra = { ...props.doc.data, readingTime };
  title = props.doc.data.title;
} else {
  normalizedDocId = props.folderPath;
  breadcrumbs = props.folderPath === 'explorar' ? [] : normalizedDocId.split('/').slice(0, -1);
  title = props.folderPath === 'explorar' ? 'Directorio Principal' : `Carpeta: ${formatName(props.folderName)}`;
  frontmatterConExtra = { title, theme: 'moderno' };
}

let linkVolver = "/";
let textoVolver = "Inicio";

if (props.type === 'folder' && props.folderPath === 'explorar') {
  linkVolver = "/";
  textoVolver = "Inicio";
} else if (breadcrumbs.length > 0) {
  linkVolver = `/docs/${breadcrumbs.join('/')}`;
  textoVolver = formatName(breadcrumbs[breadcrumbs.length - 1]);
} else {
  linkVolver = "/docs/explorar";
  textoVolver = "Directorio Principal";
}
---

<Base title={title} headings={headings} frontmatter={frontmatterConExtra}>
  <div class="doc-container">
    {props.type === 'file' ? (
    <div id="document-view">
      <!-- Barra de herramientas superior: Copiar Markdown -->
      <div style="display: flex; justify-content: flex-end; margin-bottom: 1rem;">
        <button 
          type="button" 
          id="btn-copiar-md" 
          class="copy-code-btn" 
          style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.75rem; border-radius: 6px; cursor: pointer; border: 1px solid var(--border-color); background: var(--header-bg); color: var(--text-color);"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span>Copiar Markdown (.md)</span>
        </button>
      </div>

      <article class="markdown-body" data-pagefind-body>
        {(props.doc.data.mostrarCabecera || props.doc.data.integrantes || props.doc.data.institucion) && (
          <DocReportHeader data={props.doc.data} />
        )}
        <Content />
      </article>

      {props.doc.data.mostrarNav !== false && (
        <>
          <hr class="nav-divider" />
          <div class="doc-nav">
            {props.prev ? (
              <a href={`/docs/${props.prev.id.replace(/\\/g, '/')}`} class="nav-btn prev">
                <span class="nav-label">&larr; Anterior</span>
                <span class="nav-title">{props.prev.data.title}</span>
              </a>
            ) : (
              <div class="nav-btn disabled prev">
                <span class="nav-label">&larr; Anterior</span>
                <span class="nav-title">Inicio de sección</span>
              </div>
            )}
            {props.next ? (
              <a href={`/docs/${props.next.id.replace(/\\/g, '/')}`} class="nav-btn next">
                <span class="nav-label">Siguiente &rarr;</span>
                <span class="nav-title">{props.next.data.title}</span>
              </a>
            ) : (
              <div class="nav-btn disabled next">
                <span class="nav-label">Siguiente &rarr;</span>
                <span class="nav-title">Fin de sección</span>
              </div>
            )}
          </div>
        </>
      )}
    </div>
    ) : (
      <FolderView 
        linkVolver={linkVolver}
        textoVolver={textoVolver}
        folderPath={props.folderPath}
        folderName={props.folderName}
        subfolders={props.subfolders}
        directFiles={props.directFiles}
      />
    )}
  </div>
  <GraphModal />

  {props.type === 'file' && (
    <script define:vars={{ rawBody, frontmatter: props.doc.data }}>
      const btn = document.getElementById('btn-copiar-md');
      if (btn) {
        btn.addEventListener('click', async () => {
          // Reconstruir el archivo completo con frontmatter YAML
          const yamlLines = Object.entries(frontmatter)
            .filter(([_, val]) => val !== undefined && val !== null)
            .map(([k, v]) => `${k}: ${typeof v === 'object' ? JSON.stringify(v) : v}`);
          
          const yamlString = `---\n${yamlLines.join('\n')}\n---\n\n`;
          const fullMarkdown = yamlString + rawBody;

          await navigator.clipboard.writeText(fullMarkdown);
          
          const label = btn.querySelector('span');
          if (label) {
            const original = label.textContent;
            label.textContent = '¡Copiado al Portapapeles!';
            btn.style.borderColor = '#10b981';
            btn.style.color = '#10b981';
            setTimeout(() => {
              label.textContent = original;
              btn.style.borderColor = '';
              btn.style.color = '';
            }, 1800);
          }
        });
      }
    </script>
  )}
</Base>