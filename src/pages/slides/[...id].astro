---
// src/pages/slides/[...id].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import 'reveal.js/reveal.css';
import 'reveal.js/theme/black.css';
import 'reveal.js/plugin/highlight/monokai.css';
import '../../styles/mermaid.css';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const slideDocs = allDocs.filter(
    (doc: CollectionEntry<'docs'>) => doc.data.draft !== true && doc.data.slides === true
  );

  return slideDocs.map((doc: CollectionEntry<'docs'>) => ({
    params: { id: doc.id.replace(/\\/g, '/') },
    props: { doc },
  }));
}

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
const contentBody = doc.body || '';
---

<!DOCTYPE html>
<html lang="es" data-modo="oscuro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentación: {doc.data.title}</title>
  <style is:global>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: #191919;
    }
    .reveal {
      width: 100vw !important;
      height: 100vh !important;
    }
    .reveal h1, .reveal h2, .reveal h3 { 
      text-transform: none; 
      color: #a78bfa; 
      font-weight: bold; 
      text-align: center;
    }
    .reveal p, .reveal li { 
      font-size: 1.15em; 
      line-height: 1.6; 
    }
    .reveal pre { 
      width: 100%; 
      max-height: 65vh; 
      margin: 20px auto; 
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); 
      border-radius: 8px; 
    }
    .reveal pre code { 
      max-height: 65vh !important; 
      overflow-y: auto !important; 
      padding: 20px; 
    }

    /* ==============================================================
       CONTENEDOR DE MERMAID EN SLIDES
       ============================================================== */
    .reveal .slide-mermaid-scroll-box {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 880px !important;
      max-width: 90vw !important;
      max-height: 52vh !important;
      margin: 1.5rem auto !important;
      padding: 1.25rem !important;
      background: #141416 !important;
      border: 1px solid rgba(255, 255, 255, 0.15) !important;
      border-radius: 12px !important;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6) !important;
      overflow: hidden;
      box-sizing: border-box !important;
      text-align: center !important;
      scrollbar-width: thin !important;
      scrollbar-color: #8b5cf6 rgba(255, 255, 255, 0.08) !important;
      pointer-events: auto !important;
    }

    /* Scroll activo solo con dimensiones forzadas o panorámicas */
    .reveal .slide-mermaid-scroll-box.has-scroll {
      overflow-x: auto !important;
      overflow-y: auto !important;
      display: block !important;
    }

    .reveal .slide-mermaid-scroll-box::-webkit-scrollbar {
      width: 8px !important;
      height: 8px !important;
    }
    .reveal .slide-mermaid-scroll-box::-webkit-scrollbar-thumb {
      background: #8b5cf6 !important;
      border-radius: 4px !important;
    }

    /* Ajuste de escala automático sin desbordamiento */
    .reveal .slide-mermaid-scroll-box:not(.has-scroll) svg {
      max-width: 100% !important;
      max-height: 46vh !important;
      width: auto !important;
      height: auto !important;
      display: block !important;
      margin: 0 auto !important;
    }

    .reveal .slide-mermaid-scroll-box.has-scroll svg {
      display: inline-block !important;
      max-width: none !important;
      height: auto !important;
      margin: 0 auto !important;
    }

    /* ==============================================================
       SOLUCIÓN A FÓRMULAS Y TEXTOS EN NODOS DE MERMAID
       ============================================================== */
    .reveal .slide-mermaid-scroll-box foreignObject {
      overflow: visible !important;
    }

    /* Centrado flex para forzar que el contenido ocupe el centro exacto del nodo */
    .reveal .slide-mermaid-scroll-box foreignObject > div {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .reveal .slide-mermaid-scroll-box foreignObject p,
    .reveal .slide-mermaid-scroll-box foreignObject span,
    .reveal .slide-mermaid-scroll-box .nodeLabel {
      margin: 0 !important;
      padding: 0 !important;
      font-family: system-ui, -apple-system, sans-serif !important;
      font-size: 13px !important;
      line-height: normal !important;
      color: #f8fafc !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      white-space: normal !important;
    }

    /* Reset para MathJax dentro de los nodos */
    .reveal .slide-mermaid-scroll-box mjx-container {
      margin: 0 !important;
      padding: 0 !important;
      display: inline-block !important;
      line-height: normal !important;
    }

    .reveal .slide-mermaid-scroll-box mjx-container[display="true"] {
      margin: 0 !important;
      display: inline-block !important;
    }

    .reveal .slide-mermaid-scroll-box text,
    .reveal .slide-mermaid-scroll-box .label,
    .reveal .slide-mermaid-scroll-box .edgeLabel {
      font-family: system-ui, -apple-system, sans-serif !important;
      font-size: 13px !important;
      line-height: normal !important;
      fill: #f8fafc !important;
    }

    /* Botón flotante para cerrar diapositiva */
    .btn-exit {
      position: fixed; 
      top: 18px; 
      left: 18px; 
      z-index: 9999;
      background: rgba(255, 255, 255, 0.1); 
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.2); 
      padding: 8px 16px;
      border-radius: 8px; 
      cursor: pointer; 
      font-size: 0.85rem;
      font-family: system-ui, sans-serif; 
      text-decoration: none;
      backdrop-filter: blur(5px); 
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-exit:hover { 
      background: #ef4444; 
      border-color: #ef4444; 
    }
  </style>
</head>
<body>
  <button onclick="window.close()" class="btn-exit" aria-label="Cerrar ventana">
    ✕ Cerrar (Q)
  </button>
  <div class="reveal">
    <div class="slides">
      <section data-markdown data-separator="^\n---\n$" data-separator-vertical="^\n--\n$">
        <textarea data-template>{contentBody}</textarea>
      </section>
    </div>
  </div>

  <script>
    import Reveal from 'reveal.js';
    import { getThemeForDiagram } from '../../utils/mermaidThemes';

    function detectDiagramType(code: string): string {
      let clean = code.replace(/%%[\s\S]*?%%/g, '').trim();
      if (clean.startsWith('---')) {
        const yamlEndIndex = clean.indexOf('---', 3);
        if (yamlEndIndex !== -1) {
          clean = clean.slice(yamlEndIndex + 3).trim();
        }
      }
      if (clean.startsWith('flowchart') || clean.startsWith('graph')) return 'flowchart';
      if (clean.startsWith('erDiagram')) return 'er';
      if (clean.startsWith('quadrantChart')) return 'quadrant';
      if (clean.startsWith('sequenceDiagram')) return 'sequence';
      if (clean.startsWith('classDiagram')) return 'classDiagram';
      if (clean.startsWith('stateDiagram')) return 'state';
      if (clean.startsWith('gitGraph')) return 'gitGraph';
      if (clean.startsWith('pie')) return 'pie';
      if (clean.startsWith('mindmap')) return 'mindmap';
      if (clean.startsWith('gantt')) return 'gantt';
      return 'flowchart';
    }

    async function initSlides() {
      // 1. Proteger los bloques de Mermaid para que MathJax no los mutile antes de tiempo
      document.querySelectorAll('.reveal pre code').forEach((el) => {
        const txt = el.textContent || '';
        if (
          el.classList.contains('language-mermaid') || 
          el.classList.contains('mermaid') ||
          txt.startsWith('graph') || 
          txt.startsWith('flowchart') ||
          txt.startsWith('---')
        ) {
          el.classList.add('tex2jax_ignore');
          el.closest('pre')?.classList.add('tex2jax_ignore');
        }
      });

      const [
        { default: Markdown },
        { default: Highlight },
        { default: RevealMath },
        { default: Notes }
      ] = await Promise.all([
        import('reveal.js/plugin/markdown' as any),
        import('reveal.js/plugin/highlight' as any),
        import('reveal.js/plugin/math' as any),
        import('reveal.js/plugin/notes' as any)
      ]);

      const deck = new (Reveal as any)({
        controls: true,
        progress: true,
        center: true,
        hash: true,
        transition: 'slide',
        mouseWheel: false,
        plugins: [ Markdown, Highlight, RevealMath.MathJax3, Notes ]
      });

      let mermaidInstance: any = null;

      async function renderSlidesMermaid() {
        const codeElements = Array.from(document.querySelectorAll('.reveal pre code'));
        
        const mermaidKeywords = [
          'graph ', 'graph\n', 'flowchart ', 'flowchart\n', 
          'sequenceDiagram', 'classDiagram', 'stateDiagram', 
          'erDiagram', 'gantt', 'pie', 'gitGraph', 'quadrantChart', 'mindmap', 'xychart'
        ];

        const targets = codeElements.filter(el => {
          if (el.classList.contains('language-mermaid') || el.classList.contains('mermaid')) {
            return true;
          }
          const text = (el.textContent || '').trim();
          return mermaidKeywords.some(kw => text.startsWith(kw) || text.includes('%%layout:') || text.includes('%%width:') || text.startsWith('---'));
        });

        if (targets.length === 0) return;

        if (!mermaidInstance) {
          const { default: m } = await import('mermaid');
          mermaidInstance = m;
          mermaidInstance.initialize({
            startOnLoad: false,
            look: 'classic',
            theme: 'base',
            htmlLabels: true,
            themeVariables: { 
              background: 'transparent',
              fontFamily: 'system-ui, -apple-system, sans-serif',
              fontSize: '13px'
            }
          });
        }

        for (const [idx, codeEl] of targets.entries()) {
          const pre = codeEl.closest('pre');
          if (!pre || pre.dataset.mermaidDone === 'true') continue;
          pre.dataset.mermaidDone = 'true';

          const code = (codeEl.textContent || '').trim();
          const layoutMatch = code.match(/%%layout:\s*(fit|pan-x|pan-y)\s*%%/i);
          const widthMatch = code.match(/%%width:\s*(\d+(?:px|%)?)\s*%%/i);
          const heightMatch = code.match(/%%height:\s*(\d+(?:px|%)?)\s*%%/i);

          const hasCustomDimensions = Boolean(widthMatch || heightMatch || (layoutMatch && layoutMatch[1].toLowerCase() !== 'fit'));

          let cleanCode = code
            .replace(/%%layout:.*?%%/gi, '')
            .replace(/%%width:.*?%%/gi, '')
            .replace(/%%max-width:.*?%%/gi, '')
            .replace(/%%height:.*?%%/gi, '')
            .trim();

          const hasCustomConfig = cleanCode.includes('%%{init') || cleanCode.startsWith('---');
          const isGantt = cleanCode.replace(/%%[\s\S]*?%%/g, '').trim().startsWith('gantt');
          const diagramType = detectDiagramType(cleanCode);

          let codeToRender = cleanCode;

          if (isGantt) {
            const numericWidth = widthMatch ? parseInt(widthMatch[1], 10) : 1200;
            codeToRender = hasCustomConfig 
              ? cleanCode 
              : `%%{init: { 'gantt': { 'useWidth': ${numericWidth} } } }%%\n` + cleanCode;
          } else if (!hasCustomConfig) {
            const initConfig = getThemeForDiagram(diagramType);
            const generatedInit = `%%{init: ${JSON.stringify(initConfig)} }%%\n`;
            codeToRender = generatedInit + cleanCode;
          }

          if (!codeToRender) continue;

          const renderId = `slide-mermaid-${Date.now()}-${idx}`;

          try {
            const { svg } = await mermaidInstance.render(renderId, codeToRender);

            const scrollBox = document.createElement('div');
            scrollBox.className = 'slide-mermaid-scroll-box';
            if (hasCustomDimensions || isGantt) {
              scrollBox.classList.add('has-scroll');
            }
            scrollBox.innerHTML = svg;

            // Bloquear que el scroll accidental cambie de slide
            scrollBox.addEventListener('wheel', (e: WheelEvent) => {
              if (scrollBox.classList.contains('has-scroll')) {
                e.stopPropagation();
              }
            }, { passive: true });

            scrollBox.addEventListener('touchmove', (e: TouchEvent) => {
              if (scrollBox.classList.contains('has-scroll')) {
                e.stopPropagation();
              }
            }, { passive: true });

            const svgEl = scrollBox.querySelector('svg');
            if (svgEl) {
              if (widthMatch) {
                const w = widthMatch[1].endsWith('%') || widthMatch[1].endsWith('px') ? widthMatch[1] : `${widthMatch[1]}px`;
                svgEl.style.width = w;
                svgEl.style.minWidth = w;
              }
              if (heightMatch) {
                const h = heightMatch[1].endsWith('%') || heightMatch[1].endsWith('px') ? heightMatch[1] : `${heightMatch[1]}px`;
                svgEl.style.height = h;
              }
            }

            pre.replaceWith(scrollBox);

            // Re-renderizar KaTeX/MathJax dentro del SVG generado si contiene fórmulas
            if ((window as any).MathJax && (window as any).MathJax.typesetPromise) {
              await (window as any).MathJax.typesetPromise([scrollBox]);
            }
          } catch (err) {
            console.error('Error renderizando Mermaid en slide:', err);
            pre.dataset.mermaidDone = 'false';
          }
        }

        deck.layout();
      }

      deck.on('ready', () => {
        renderSlidesMermaid();
      });

      deck.on('slidechanged', () => {
        renderSlidesMermaid();
      });

      deck.initialize();

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key.toLowerCase() === 'q') {
          window.close();
        }
      });
    }

    initSlides();
  </script>
</body>
</html>