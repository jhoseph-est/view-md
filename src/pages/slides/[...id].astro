---
// src/pages/slides/[...id].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import 'reveal.js/reveal.css';
import 'reveal.js/theme/black.css';
import 'reveal.js/plugin/highlight/monokai.css';
import '../../styles/mermaid.css';
import '../../styles/slides.css';
import estilosBase from '../../config/estilos-base.json';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const slideDocs = allDocs.filter(
    (doc: CollectionEntry<'docs'>) => doc.data.draft !== true && doc.data.slides === true
  );

  return slideDocs.map((doc: CollectionEntry<'docs'>) => {
    const cleanId = doc.id
      .replace(/\\/g, '/')
      .replace(/\.(md|mdx)$/, '');

    return {
      params: { id: cleanId },
      props: { doc },
    };
  });
}

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
const contentBody = doc.body || '';

const temaId = doc.data.theme || 'default';
const temaConfig = (estilosBase as any)[temaId] || (estilosBase as any)['default'];
const bgDark = temaConfig?.oscuro?.superficies?.fondoPrincipal || '#0f172a';
const bgLight = temaConfig?.claro?.superficies?.fondoPrincipal || '#f8fafc';
const textDark = temaConfig?.oscuro?.textos?.principal || '#f8fafc';
const textLight = temaConfig?.claro?.textos?.principal || '#0f172a';
---

<!DOCTYPE html>
<html lang="es" data-modo="oscuro" data-estilo={temaId}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentación: {doc.data.title}</title>
  <script is:inline define:vars={{ temaId }}>
    (function () {
      const html = document.documentElement;
      const modo = localStorage.getItem('pref-modo') || 'oscuro';
      const estilo = temaId || localStorage.getItem('pref-estilo') || 'default';
      html.setAttribute('data-modo', modo);
      html.setAttribute('data-estilo', estilo);
    })();
  </script>
  <style define:vars={{ bgDark, bgLight, textDark, textLight }}>
    html[data-modo="oscuro"] body, html[data-modo="oscuro"] .reveal {
      background-color: var(--bgDark) !important;
      color: var(--textDark) !important;
    }
    html[data-modo="claro"] body, html[data-modo="claro"] .reveal {
      background-color: var(--bgLight) !important;
      color: var(--textLight) !important;
    }
  </style>
</head>
<body>
  <button onclick="window.close()" class="btn-exit" aria-label="Cerrar ventana">
    ✕ Cerrar (Q)
  </button>
  <div class="reveal">
    <div class="slides">
      <section data-markdown data-separator="^\n---\n$" data-separator-vertical="^\n--\n$">
        <textarea data-template>{contentBody}</textarea>
      </section>
    </div>
  </div>

  <script>
    import Reveal from 'reveal.js';
    import { getThemeForDiagram } from '../../utils/mermaidThemes';

    function detectDiagramType(code: string): string {
      let clean = code.replace(/%%[\s\S]*?%%/g, '').trim();
      if (clean.startsWith('---')) {
        const yamlEndIndex = clean.indexOf('---', 3);
        if (yamlEndIndex !== -1) {
          clean = clean.slice(yamlEndIndex + 3).trim();
        }
      }
      if (clean.startsWith('flowchart') || clean.startsWith('graph')) return 'flowchart';
      if (clean.startsWith('erDiagram')) return 'er';
      if (clean.startsWith('quadrantChart')) return 'quadrant';
      if (clean.startsWith('sequenceDiagram')) return 'sequence';
      if (clean.startsWith('classDiagram')) return 'classDiagram';
      if (clean.startsWith('stateDiagram')) return 'state';
      if (clean.startsWith('gitGraph')) return 'gitGraph';
      if (clean.startsWith('pie')) return 'pie';
      if (clean.startsWith('mindmap')) return 'mindmap';
      if (clean.startsWith('gantt')) return 'gantt';
      return 'flowchart';
    }

    async function initSlides() {
      // Marcar los bloques para evitar que KaTeX los altere
      document.querySelectorAll('.reveal pre code').forEach((el) => {
        const txt = el.textContent || '';
        if (
          el.classList.contains('language-mermaid') || 
          el.classList.contains('mermaid') ||
          txt.includes('flowchart') || 
          txt.includes('graph') ||
          txt.includes('sequenceDiagram') ||
          txt.includes('classDiagram') ||
          txt.includes('stateDiagram') ||
          txt.includes('erDiagram') ||
          txt.includes('gantt') ||
          txt.includes('pie') ||
          txt.includes('gitGraph') ||
          txt.includes('mindmap') ||
          txt.startsWith('---')
        ) {
          el.classList.add('tex2jax_ignore');
          el.closest('pre')?.classList.add('tex2jax_ignore');
        }
      });

      const [
        { default: Markdown },
        { default: Highlight },
        { default: RevealMath },
        { default: Notes }
      ] = await Promise.all([
        import('reveal.js/plugin/markdown' as any),
        import('reveal.js/plugin/highlight' as any),
        import('reveal.js/plugin/math' as any),
        import('reveal.js/plugin/notes' as any)
      ]);

      const deck = new (Reveal as any)({
        controls: true,
        progress: true,
        center: true,
        hash: true,
        transition: 'slide',
        mouseWheel: false,
        plugins: [ Markdown, Highlight, RevealMath.MathJax3, Notes ]
      });

      let mermaidInstance: any = null;

      async function renderSlidesMermaid() {
        // Seleccionamos los bloques de código mermaid de las diapositivas
        const codeElements = Array.from(document.querySelectorAll('.reveal pre code'));
        
        const targets = codeElements.filter(el => {
          const pre = el.closest('pre');
          if (!pre || pre.dataset.mermaidDone === 'true') return false;
          if (el.classList.contains('language-mermaid') || el.classList.contains('mermaid')) return true;
          const text = (el.textContent || '').trim();
          return text.startsWith('graph') || text.startsWith('flowchart') || text.startsWith('sequenceDiagram') || text.startsWith('classDiagram') || text.startsWith('stateDiagram') || text.startsWith('erDiagram') || text.startsWith('gantt') || text.startsWith('pie') || text.startsWith('gitGraph') || text.startsWith('quadrantChart') || text.startsWith('mindmap') || text.startsWith('---') || text.includes('%%{init');
        });

        if (targets.length === 0) return;

        if (!mermaidInstance) {
          const { default: m } = await import('mermaid');
          mermaidInstance = m;
          mermaidInstance.initialize({
            startOnLoad: false,
            look: 'classic',
            theme: 'base',
            htmlLabels: true,
            themeVariables: { 
              background: 'transparent',
              fontFamily: 'system-ui, -apple-system, sans-serif',
              fontSize: '13px'
            }
          });
        }

        for (const [idx, codeEl] of targets.entries()) {
          const pre = codeEl.closest('pre');
          if (!pre || pre.dataset.mermaidDone === 'true') continue;
          pre.dataset.mermaidDone = 'true';

          const code = (codeEl.textContent || '').trim();
          if (!code) continue;

          const layoutMatch = code.match(/%%layout:\s*(fit|pan-x|pan-y)\s*%%/i);
          const widthMatch = code.match(/%%width:\s*(\d+(?:px|%)?)\s*%%/i);
          const heightMatch = code.match(/%%height:\s*(\d+(?:px|%)?)\s*%%/i);

          const hasCustomDimensions = Boolean(widthMatch || heightMatch || (layoutMatch && layoutMatch[1].toLowerCase() !== 'fit'));

          let cleanCode = code
            .replace(/%%layout:.*?%%/gi, '')
            .replace(/%%width:.*?%%/gi, '')
            .replace(/%%max-width:.*?%%/gi, '')
            .replace(/%%height:.*?%%/gi, '')
            .trim();

          const hasCustomConfig = cleanCode.includes('%%{init') || cleanCode.startsWith('---');
          const isGantt = cleanCode.replace(/%%[\s\S]*?%%/g, '').trim().startsWith('gantt');
          const diagramType = detectDiagramType(cleanCode);

          let codeToRender = cleanCode;

          if (!hasCustomConfig) {
            const baseConfig = getThemeForDiagram(diagramType);
            let initConfig = { ...baseConfig };

            if (isGantt) {
              const numericWidth = widthMatch ? parseInt(widthMatch[1], 10) : 1200;
              initConfig = {
                ...baseConfig,
                gantt: {
                  ...(baseConfig.gantt || {}),
                  useWidth: numericWidth
                }
              };
            }

            const generatedInit = `%%{init: ${JSON.stringify(initConfig)} }%%\n`;
            codeToRender = generatedInit + cleanCode;
          }

          const renderId = `slide-mermaid-${Date.now()}-${idx}`;

          try {
            const { svg } = await mermaidInstance.render(renderId, codeToRender);

            const scrollBox = document.createElement('div');
            scrollBox.className = 'slide-mermaid-scroll-box';
            
            // Si el diagrama es grande o tiene dimensiones personalizadas, activamos el scroll interno controlado
            if (hasCustomDimensions || isGantt) {
              scrollBox.classList.add('has-scroll');
            }
            scrollBox.innerHTML = svg;

            scrollBox.addEventListener('wheel', (e: WheelEvent) => {
              if (scrollBox.classList.contains('has-scroll')) {
                e.stopPropagation();
              }
            }, { passive: true });

            scrollBox.addEventListener('touchmove', (e: TouchEvent) => {
              if (scrollBox.classList.contains('has-scroll')) {
                e.stopPropagation();
              }
            }, { passive: true });

            const svgEl = scrollBox.querySelector('svg');
            if (svgEl) {
              if (widthMatch) {
                const w = widthMatch[1].endsWith('%') || widthMatch[1].endsWith('px') ? widthMatch[1] : `${widthMatch[1]}px`;
                svgEl.style.width = w;
                svgEl.style.minWidth = w;
              }
              if (heightMatch) {
                const h = heightMatch[1].endsWith('%') || heightMatch[1].endsWith('px') ? heightMatch[1] : `${heightMatch[1]}px`;
                svgEl.style.height = h;
              }
            }

            pre.replaceWith(scrollBox);

            if ((window as any).MathJax && (window as any).MathJax.typesetPromise) {
              await (window as any).MathJax.typesetPromise([scrollBox]);
            }
          } catch (err) {
            console.warn('Error renderizando Mermaid en slide, aplicando fallback:', err);
            pre.dataset.mermaidDone = 'false';
          }
        }

        deck.layout();
      }

      deck.on('ready', () => {
        renderSlidesMermaid();
      });

      deck.on('slidechanged', () => {
        renderSlidesMermaid();
      });

      deck.initialize();

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key.toLowerCase() === 'q') {
          window.close();
        }
      });
    }

    initSlides();
  </script>
</body>
</html>