---
// src/pages/slides/[...id].astro
import { getCollection, type CollectionEntry } from 'astro:content';

import 'reveal.js/reveal.css';
import 'reveal.js/theme/black.css';
import 'reveal.js/plugin/highlight/monokai.css';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const slideDocs = allDocs.filter(
    (doc: CollectionEntry<'docs'>) => doc.data.draft !== true && doc.data.slides === true
  );

  return slideDocs.map((doc: CollectionEntry<'docs'>) => ({
    params: { id: doc.id.replace(/\\/g, '/') },
    props: { doc },
  }));
}

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
const contentBody = doc.body || '';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentación: {doc.data.title}</title>
  
  <style>
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: #191919;
    }
    .reveal {
      width: 100vw !important;
      height: 100vh !important;
    }
    .reveal h1, .reveal h2, .reveal h3 { 
      text-transform: none; 
      color: #a78bfa; 
      font-weight: bold; 
    }
    .reveal p, .reveal li { 
      font-size: 1.15em; 
      line-height: 1.6; 
    }
    .reveal pre { 
      width: 100%; 
      max-height: 65vh; 
      margin: 20px auto; 
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); 
      border-radius: 8px; 
    }
    .reveal pre code { 
      max-height: 65vh !important; 
      overflow-y: auto !important; 
      padding: 20px; 
    }
    .btn-exit {
      position: fixed; 
      top: 18px; 
      left: 18px; 
      z-index: 9999;
      background: rgba(255, 255, 255, 0.1); 
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.2); 
      padding: 8px 16px;
      border-radius: 8px; 
      cursor: pointer; 
      font-size: 0.85rem;
      font-family: system-ui, sans-serif; 
      text-decoration: none;
      backdrop-filter: blur(5px); 
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-exit:hover { 
      background: #ef4444; 
      border-color: #ef4444; 
    }
  </style>
</head>
<body>
  <button onclick="window.close()" class="btn-exit" aria-label="Cerrar ventana">
    ✕ Cerrar (Q)
  </button>
  
  <div class="reveal">
    <div class="slides">
      <section data-markdown data-separator="^\n---\n$" data-separator-vertical="^\n--\n$">
        <textarea data-template>{contentBody}</textarea>
      </section>
    </div>
  </div>

  <script>
    import Reveal from 'reveal.js';

    async function initSlides() {
      // Importaciones dinámicas oficiales que Vite resuelve sin violar el "exports" de Node
      const [
        { default: Markdown },
        { default: Highlight },
        { default: RevealMath },
        { default: Notes }
      ] = await Promise.all([
        import('reveal.js/plugin/markdown' as any),
        import('reveal.js/plugin/highlight' as any),
        import('reveal.js/plugin/math' as any),
        import('reveal.js/plugin/notes' as any)
      ]);

      const deck = new (Reveal as any)({
        controls: true,
        progress: true,
        center: true,
        hash: true,
        transition: 'slide',
        plugins: [ Markdown, Highlight, RevealMath.MathJax3, Notes ]
      });

      deck.initialize();

      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key.toLowerCase() === 'q') {
          window.close();
        }
      });
    }

    initSlides();
  </script>
</body>
</html>