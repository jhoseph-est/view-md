---
// src/pages/taller-editorial.astro
import { getEntry, render } from 'astro:content';
import '../styles/base.css';
import { generateThemeCss } from '../utils/themeInjector';

import estilosBase from '../config/estilos-base.json';
import plantillasImpresion from '../config/plantillas-impresion.json';
import caratulas from '../config/caratulas.json';
import componentes from '../config/componentes.json';
import diagramasMermaid from '../config/diagramas-mermaid.json';

import PanelTemaWeb from '../components/taller/PanelTemaWeb.astro';
import PanelImpresion from '../components/taller/PanelImpresion.astro';
import PanelCaratula from '../components/taller/PanelCaratula.astro';

const dynamicCss = generateThemeCss();
const plantillasList = Object.entries(plantillasImpresion as Record<string, any>);
const caratulasList = Object.entries(caratulas as Record<string, any>);
const estilosBaseList = Object.keys(estilosBase as Record<string, any>);

let testDocEntry: any = null;
let RenderedContent: any = null;
let docData: any = {};

try {
  testDocEntry = await getEntry('docs', 'sistema/banco-pruebas');
  if (testDocEntry) {
    const rendered = await render(testDocEntry);
    RenderedContent = rendered.Content;
    docData = testDocEntry.data || {};
  }
} catch (e) {}

const jsonState = { estilosBase, plantillasImpresion, caratulas, componentes, diagramasMermaid };
---

<!DOCTYPE html>
<html lang="es" data-modo="claro" data-estilo="moderno">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Taller Editorial — Estudio de Diseño</title>
    <style is:global set:html={dynamicCss}></style>
    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        background-color: #090b0e !important;
        font-family: var(--ui-font, system-ui, sans-serif) !important;
        color: #f1f5f9;
      }
      .taller-container { display: flex; width: 100vw; height: 100vh; overflow: hidden; }
      .taller-sidebar {
        width: 400px;
        min-width: 400px;
        height: 100vh;
        background-color: #11151b;
        border-right: 1px solid #1f2633;
        display: flex;
        flex-direction: column;
        z-index: 50;
      }
      .sidebar-top {
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #1f2633;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #161b24;
      }
      .sidebar-title {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--accent-color, #8b5cf6);
        margin: 0;
      }
      .btn-exit-taller {
        color: #94a3b8;
        font-size: 0.72rem;
        text-decoration: none;
        padding: 0.3rem 0.5rem;
        border-radius: 4px;
        border: 1px solid #273142;
      }
      .btn-exit-taller:hover { background: rgba(255, 255, 255, 0.05); color: #fff; }
      .taller-nav-tabs {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        background: #0d1015;
        border-bottom: 1px solid #1f2633;
        padding: 0.2rem;
        gap: 2px;
      }
      .tab-btn {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.55rem 0.2rem;
        cursor: pointer;
        border-radius: 4px;
        text-align: center;
      }
      .tab-btn.is-active {
        background: var(--accent-subtle, rgba(139, 92, 246, 0.18));
        color: var(--accent-color, #8b5cf6);
      }
      .sidebar-scroll-body { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 1rem; }
      .tab-panel { display: none; flex-direction: column; gap: 1rem; }
      .tab-panel.is-active { display: flex; }
      .preset-banner {
        background: #141923;
        border: 1px solid #232c3d;
        border-left: 3px solid var(--accent-color, #8b5cf6);
        padding: 0.6rem 0.8rem;
        border-radius: 6px;
      }
      .preset-banner h3 { margin: 0; font-size: 0.75rem; text-transform: uppercase; color: #f1f5f9; }
      .preset-banner p { margin: 0.2rem 0 0 0; font-size: 0.67rem; color: #94a3b8; }
      .control-box {
        background: #131720;
        border: 1px solid #202736;
        border-radius: 8px;
        padding: 0.85rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }
      .control-box-title { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #818cf8; margin: 0; }
      .ctrl-field { display: flex; flex-direction: column; gap: 0.25rem; }
      .ctrl-field-inline { display: flex; justify-content: space-between; align-items: center; }
      .ctrl-field label, .ctrl-field-inline label { font-size: 0.72rem; color: #cbd5e1; }
      .field-row { display: flex; align-items: center; gap: 6px; }
      .flex-1 { flex: 1; }
      .val-badge { font-size: 0.7rem; width: 38px; text-align: right; color: #94a3b8; }
      .taller-input, .taller-select {
        background: #0b0e13;
        border: 1px solid #293447;
        color: #f8fafc;
        padding: 0.35rem 0.55rem;
        border-radius: 5px;
        font-size: 0.76rem;
      }
      .taller-color-picker { width: 34px; height: 24px; padding: 1px; border: 1px solid #293447; border-radius: 4px; background: #0b0e13; cursor: pointer; }
      .action-btn-group { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.3rem; }
      .btn-taller-action {
        width: 100%;
        border: none;
        padding: 0.6rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.76rem;
        cursor: pointer;
      }
      .btn-update { background: #222938; color: #cbd5e1; border: 1px solid #334155; }
      .btn-new-preset { background: var(--accent-color, #8b5cf6); color: #fff; }
      
      /* LIENZOS DUALES */
      .taller-viewport { flex: 1; height: 100vh; overflow-y: auto; overflow-x: hidden; background-color: var(--bg-color, #ffffff); }
      .view-web-canvas { display: block; width: 100%; max-width: 900px; margin: 0 auto; padding: 2.5rem 2rem 5rem 2rem; }
      .view-print-canvas { display: none; flex-direction: column; align-items: center; gap: 2.5rem; padding: 2.5rem 1.5rem 5rem 1.5rem; background-color: #090b0e; }
      .sheet-wrapper { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
      .sheet-badge { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; color: #94a3b8; background: #141923; border: 1px solid #232c3d; padding: 0.2rem 0.55rem; border-radius: 4px; }
      .a4-preview-sheet {
        width: 210mm;
        height: 297mm;
        max-height: 297mm;
        background-color: #ffffff !important;
        color: #0f172a !important;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.7);
        padding: var(--test-margin-v, 2.54cm) var(--test-margin-h, 2.54cm);
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .sample-paragraph {
        font-family: var(--test-font-cuerpo, serif);
        line-height: var(--test-line-height, 1.8);
        text-indent: var(--test-para-indent, 1.27cm);
        text-align: var(--test-para-align, justify);
        color: #000000;
        margin-bottom: 0.85rem;
      }
    </style>
  </head>
  <body>
    <div class="taller-container" id="taller-app" data-initial-state={JSON.stringify(jsonState)}>
      <aside class="taller-sidebar">
        <div class="sidebar-top">
          <h2 class="sidebar-title">Taller Editorial</h2>
          <a href="/docs/explorar" class="btn-exit-taller">← Volver a Docs</a>
        </div>
        <nav class="taller-nav-tabs">
          <button class="tab-btn is-active" data-target-tab="tab-base" data-view-mode="web">1. Web</button>
          <button class="tab-btn" data-target-tab="tab-print" data-view-mode="print">2. Papel</button>
          <button class="tab-btn" data-target-tab="tab-cover" data-view-mode="print">3. Portada</button>
        </nav>
        <div class="sidebar-scroll-body">
          <PanelTemaWeb estilosList={estilosBaseList} />
          <PanelImpresion plantillasList={plantillasList} />
          <PanelCaratula caratulasList={caratulasList} />
        </div>
      </aside>

      <!-- LIENZOS REACTIVOS -->
      <main class="taller-viewport">
        <!-- VISTA WEB -->
        <section class="view-web-canvas" id="canvas-web">
          <article class="markdown-body" id="web-doc-body">
            {RenderedContent ? <RenderedContent /> : <p style="text-align:center; opacity:0.5;">Cargando banco-pruebas...</p>}
          </article>
        </section>

        <!-- VISTA HOJA A4 -->
        <section class="view-print-canvas" id="canvas-print">
          <div class="sheet-wrapper">
            <span class="sheet-badge">Maqueta 1: Portada</span>
            <article class="a4-preview-sheet" id="sheet-cover">
              <div id="demo-cover-header" style="text-align:center;">
                <h2 style="font-size:12pt; margin:0; text-transform:uppercase; font-weight:800;">
                  {docData.institucion || "UNIVERSIDAD NACIONAL DE INGENIERÍA"}
                </h2>
                <p style="font-size:10pt; margin:0.2rem 0; font-weight:700;">
                  {docData.facultad || "FACULTAD DE INGENIERÍA MECÁNICA"}
                </p>
                <p style="font-size:9pt; margin:0; opacity:0.8;">
                  {docData.escuela || "Escuela Profesional de Ingeniería Mecánica"}
                </p>
              </div>
              <div style="margin:2.5rem auto; text-align:center;">
                <img id="demo-cover-logo" src={docData.logo || "/assets/logos/logo-uni.png"} alt="Escudo" style="max-height:45mm; height:45mm; object-fit:contain;" />
              </div>
              <div style="text-align:center; margin:1.5rem 0;">
                <h1 style="font-size:14pt; text-transform:uppercase; margin:0.4rem 0; font-weight:800;">
                  {docData.title || "TÍTULO DEL DOCUMENTO"}
                </h1>
                {docData.subtitulo && <p style="font-size:10pt; font-style:italic; margin:0;">{docData.subtitulo}</p>}
              </div>
              <div style="margin-top:auto; margin-bottom:1.5rem;">
                <table style="width:85%; margin:0 auto; border:none; font-size:9pt;">
                  {docData.integrantes ? docData.integrantes.map((m: any, idx: number) => (
                    <tr>
                      <td style="text-align:left; font-weight:700; border:none; padding:0.15rem 0.5rem;">
                        {idx === 0 ? "INTEGRANTES:" : ""}
                      </td>
                      <td style="text-align:right; border:none; padding:0.15rem 0.5rem;">
                        {m.nombre} {m.codigo ? `(${m.codigo})` : ''}
                      </td>
                    </tr>
                  )) : (
                    <tr>
                      <td style="text-align:left; font-weight:700; border:none;">AUTOR:</td>
                      <td style="text-align:right; border:none;">ESTUDIANTE EJEMPLO</td>
                    </tr>
                  )}
                </table>
              </div>
              <div style="text-align:center;">
                <p style="font-size:9pt; font-weight:700; margin:0;">{docData.ciudad || "LIMA — PERÚ"}</p>
                <p style="font-size:9pt; margin:0;">{docData.anio || "2026"}</p>
              </div>
            </article>
          </div>

          <div class="sheet-wrapper">
            <span class="sheet-badge">Maqueta 2: Geometría de Página</span>
            <article class="a4-preview-sheet" id="sheet-body-sample">
              <h2 style="font-size:13pt; margin:0 0 1rem 0; font-weight:bold; color:#000;">1. Introducción al Formato de Impresión</h2>
              <p class="sample-paragraph">
                Este párrafo sirve como muestra directa para calibrar los márgenes físicos superior, inferior y laterales de la hoja A4, así como la sangría de primera línea obligatoria según la norma formal de publicación.
              </p>
              <p class="sample-paragraph">
                Al mover los deslizadores de márgenes y sangría en la pestaña lateral, esta hoja recalcula sus cotas en tiempo real para visualizar el balance de blancos y la densidad de texto antes de exportar a PDF.
              </p>
            </article>
          </div>
        </section>
      </main>
    </div>

    <script>
      import { renderMermaid } from '../utils/mermaidViewer';
      const root = document.documentElement;
      const appEl = document.getElementById('taller-app');
      let state: Record<string, any> = {};
      if (appEl?.dataset.initialState) {
        try { state = JSON.parse(appEl.dataset.initialState); } catch (e) {}
      }

      document.addEventListener('DOMContentLoaded', () => {
        renderMermaid(false, '#web-doc-body');
      });

      // Conmutador de Pestañas y Lienzos
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
      const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
      const canvasWeb = document.getElementById('canvas-web');
      const canvasPrint = document.getElementById('canvas-print');
      const tallerViewport = document.querySelector('.taller-viewport') as HTMLElement | null;

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => b.classList.remove('is-active'));
          tabPanels.forEach((p) => p.classList.remove('is-active'));
          btn.classList.add('is-active');

          const targetId = btn.getAttribute('data-target-tab');
          if (targetId) document.getElementById(targetId)?.classList.add('is-active');

          const viewMode = btn.getAttribute('data-view-mode');
          if (viewMode === 'print') {
            if (canvasWeb) canvasWeb.style.display = 'none';
            if (canvasPrint) canvasPrint.style.display = 'flex';
            if (tallerViewport) tallerViewport.style.backgroundColor = '#090b0e';
          } else {
            if (canvasWeb) canvasWeb.style.display = 'block';
            if (canvasPrint) canvasPrint.style.display = 'none';
            if (tallerViewport) tallerViewport.style.backgroundColor = 'var(--bg-color, #ffffff)';
          }
        });
      });

      // Reactividad en Vivo: Web
      document.getElementById('sel-base-body-font')?.addEventListener('change', (e) => {
        root.style.setProperty('--doc-font', (e.target as HTMLSelectElement).value);
      });
      document.getElementById('rng-base-lineheight')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        root.style.setProperty('--doc-line-height', val);
        document.getElementById('lbl-base-lineheight')!.textContent = val;
      });
      document.getElementById('col-base-h1')?.addEventListener('input', (e) => {
        root.style.setProperty('--color-h1', (e.target as HTMLInputElement).value);
      });
      document.getElementById('rng-base-h1')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        root.style.setProperty('--h1-size', `${val}px`);
        document.getElementById('lbl-base-h1')!.textContent = `${val}px`;
      });
      document.getElementById('col-base-h2')?.addEventListener('input', (e) => {
        root.style.setProperty('--color-h2', (e.target as HTMLInputElement).value);
      });
      document.getElementById('rng-base-h2')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        root.style.setProperty('--h2-size', `${val}px`);
        document.getElementById('lbl-base-h2')!.textContent = `${val}px`;
      });

      // Reactividad en Vivo: Impresión A4
      document.getElementById('rng-print-mv')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        root.style.setProperty('--test-margin-v', `${val}cm`);
        document.getElementById('lbl-print-mv')!.textContent = `${val}cm`;
      });
      document.getElementById('rng-print-mh')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        root.style.setProperty('--test-margin-h', `${val}cm`);
        document.getElementById('lbl-print-mh')!.textContent = `${val}cm`;
      });
      document.getElementById('rng-print-indent')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        root.style.setProperty('--test-para-indent', `${val}cm`);
        document.getElementById('lbl-print-indent')!.textContent = `${val}cm`;
      });
      document.getElementById('sel-print-align')?.addEventListener('change', (e) => {
        root.style.setProperty('--test-para-align', (e.target as HTMLSelectElement).value);
      });

      // Reactividad en Vivo: Portada
      document.getElementById('rng-cover-logo')?.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const logo = document.getElementById('demo-cover-logo');
        if (logo) {
          logo.style.maxHeight = `${val}mm`;
          logo.style.height = `${val}mm`;
        }
        document.getElementById('lbl-cover-logo')!.textContent = `${val}mm`;
      });
      document.getElementById('sel-cover-align')?.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value;
        const header = document.getElementById('demo-cover-header');
        if (header) header.style.textAlign = val;
      });

      // Exportación y Copiado de Presets
      document.querySelectorAll<HTMLButtonElement>('.btn-taller-action').forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-action');
          const target = btn.getAttribute('data-target') as keyof typeof state;
          if (!target || !state[target]) return;

          let targetDict = state[target];
          let keyToSave = '';

          if (target === 'estilosBase') {
            const basePresetKey = (document.getElementById('sel-base-preset') as HTMLSelectElement).value;
            const newIdInput = (document.getElementById('txt-base-new-id') as HTMLInputElement).value.trim();
            keyToSave = action === 'create-new' && newIdInput ? newIdInput.toLowerCase().replace(/\s+/g, '-') : basePresetKey;

            const baseCloned = JSON.parse(JSON.stringify(targetDict[basePresetKey] || targetDict.moderno));
            baseCloned.tipografia = {
              ...baseCloned.tipografia,
              fuenteCuerpo: (document.getElementById('sel-base-body-font') as HTMLSelectElement).value,
              interlineado: (document.getElementById('rng-base-lineheight') as HTMLInputElement).value,
            };
            if (baseCloned.claro?.encabezados?.h1) {
              baseCloned.claro.encabezados.h1.color = (document.getElementById('col-base-h1') as HTMLInputElement).value;
              baseCloned.claro.encabezados.h1.tamano = `${(document.getElementById('rng-base-h1') as HTMLInputElement).value}px`;
            }
            targetDict[keyToSave] = baseCloned;
          } else if (target === 'plantillasImpresion') {
            const printPresetKey = (document.getElementById('sel-print-preset') as HTMLSelectElement).value;
            const newIdInput = (document.getElementById('txt-print-new-id') as HTMLInputElement).value.trim();
            keyToSave = action === 'create-new' && newIdInput ? newIdInput.toLowerCase().replace(/\s+/g, '-') : printPresetKey;

            const printCloned = JSON.parse(JSON.stringify(targetDict[printPresetKey] || targetDict['informe-uni']));
            printCloned.id = keyToSave;
            printCloned.pagina.margenSuperior = `${(document.getElementById('rng-print-mv') as HTMLInputElement).value}cm`;
            printCloned.pagina.margenInferior = `${(document.getElementById('rng-print-mv') as HTMLInputElement).value}cm`;
            printCloned.pagina.margenIzquierdo = `${(document.getElementById('rng-print-mh') as HTMLInputElement).value}cm`;
            printCloned.pagina.margenDerecho = `${(document.getElementById('rng-print-mh') as HTMLInputElement).value}cm`;
            printCloned.parrafo.sangriaPrimeraLinea = `${(document.getElementById('rng-print-indent') as HTMLInputElement).value}cm`;
            printCloned.parrafo.alineacion = (document.getElementById('sel-print-align') as HTMLSelectElement).value;
            targetDict[keyToSave] = printCloned;
          } else if (target === 'caratulas') {
            const coverPresetKey = (document.getElementById('sel-cover-preset') as HTMLSelectElement).value;
            const newIdInput = (document.getElementById('txt-cover-new-id') as HTMLInputElement).value.trim();
            keyToSave = action === 'create-new' && newIdInput ? newIdInput.toLowerCase().replace(/\s+/g, '-') : coverPresetKey;

            const coverCloned = JSON.parse(JSON.stringify(targetDict[coverPresetKey] || targetDict['uni-oficial']));
            coverCloned.id = keyToSave;
            if (coverCloned.logo) {
              coverCloned.logo.altoMaximoMm = parseInt((document.getElementById('rng-cover-logo') as HTMLInputElement).value, 10);
            }
            targetDict[keyToSave] = coverCloned;
          }

          navigator.clipboard.writeText(JSON.stringify(targetDict, null, 2));
          const originalText = btn.textContent;
          btn.textContent = action === 'create-new' ? `✔ Creado "${keyToSave}" y Copiado!` : `✔ Actualizado y Copiado!`;
          setTimeout(() => { btn.textContent = originalText; }, 2000);
        });
      });
    </script>
  </body>
</html>