---
// src/components/ReportToc.astro
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: TocHeading[];
}

const { headings = [] } = Astro.props;

// Filtramos: omitimos el h1 inicial si coincide con el título o si es "ÍNDICE", 
// y limitamos hasta nivel 4 para mantener el índice limpio y legible
const filteredHeadings: TocHeading[] = headings.filter(
  (h: TocHeading) =>
    h &&
    h.slug &&
    h.text &&
    h.depth >= 1 &&
    h.depth <= 4 &&
    !h.text.toLowerCase().includes('índice')
);
---

<div class="report-toc-page">
  <h2 class="report-toc-title">ÍNDICE</h2>

  <ul class="formal-toc-list">
    {filteredHeadings.map((h: TocHeading) => (
      <li class={`formal-toc-item depth-${h.depth}`}>
        <a href={`#${h.slug}`} class="formal-toc-link">
          <span class="toc-text">{h.text}</span>
          <span class="toc-dots"></span>
          <span class="toc-page-num" data-heading-slug={h.slug}>
            —
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  function calculateRealPrintPages() {
    const pageNumElements = document.querySelectorAll<HTMLElement>('.toc-page-num');
    if (!pageNumElements.length) return;

    // Altura útil aproximada de una hoja A4 con márgenes (96 DPI)
    const PAGE_HEIGHT_PX = 860;
    
    // Si hay portada activa = Pág 1, Índice = Pág 2 -> El contenido arranca en Pág 3
    const hasCover = Boolean(document.querySelector('.report-cover-page'));
    const INITIAL_PAGE_OFFSET = hasCover ? 3 : 2;

    const firstContentBlock = document.querySelector('.markdown-body h1, .markdown-body h2');
    const startTop = firstContentBlock ? firstContentBlock.getBoundingClientRect().top + window.scrollY : 0;

    pageNumElements.forEach((numEl) => {
      const slug = numEl.getAttribute('data-heading-slug');
      if (!slug) return;
      const targetHeading = document.getElementById(slug);
      if (targetHeading) {
        const headingTop = targetHeading.getBoundingClientRect().top + window.scrollY;
        const relativePosition = Math.max(0, headingTop - startTop);
        const calculatedPage = Math.floor(relativePosition / PAGE_HEIGHT_PX) + INITIAL_PAGE_OFFSET;
        numEl.textContent = calculatedPage.toString();
      }
    });
  }

  // Disparar en vista previa, al cargar Astro y antes de imprimir
  window.addEventListener('beforeprint', calculateRealPrintPages);
  document.addEventListener('astro:page-load', calculateRealPrintPages);
  document.addEventListener('DOMContentLoaded', calculateRealPrintPages);
  // Un pase adicional para asegurar que Mermaid y fuentes hayan terminado de posicionarse
  setTimeout(calculateRealPrintPages, 400);
</script>

<style>
  .report-toc-page {
    box-sizing: border-box;
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 0 3rem 0;
    page-break-before: always;
    break-before: page;
    page-break-after: always;
    break-after: page;
    background: transparent !important;
    color: inherit;
  }

  .report-toc-title {
    text-align: center !important;
    font-size: 13pt !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 2rem 0 !important;
    color: inherit;
  }

  .formal-toc-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
  }

  .formal-toc-item {
    width: 100%;
    box-sizing: border-box;
  }

  /* Sangrías proporcionales equilibradas */
  .formal-toc-item.depth-1 {
    font-weight: 700;
    padding-left: 0;
    margin-top: 0.4rem;
  }

  .formal-toc-item.depth-2 {
    font-weight: 600;
    padding-left: 1.25rem;
  }

  .formal-toc-item.depth-3 {
    font-weight: 400;
    font-style: italic;
    padding-left: 2.25rem;
  }

  .formal-toc-item.depth-4 {
    font-weight: 400;
    padding-left: 3.25rem;
    opacity: 0.9;
  }

  .formal-toc-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    font-size: 10.5pt;
    line-height: 1.4;
  }

  .toc-text {
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80%;
  }

  /* Puntos suspensivos continuos y nítidos */
  .toc-dots {
    flex-grow: 1;
    margin: 0 0.5rem;
    border-bottom: 1.5px dotted currentColor;
    opacity: 0.45;
    min-width: 1.5rem;
  }

  .toc-page-num {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  @media print {
    .report-toc-page {
      padding: 0 !important;
      margin: 0 !important;
      color: #000000 !important;
    }

    .report-toc-title,
    .formal-toc-link {
      color: #000000 !important;
    }

    .toc-dots {
      border-bottom-color: #000000 !important;
      opacity: 0.4 !important;
    }
  }
</style>