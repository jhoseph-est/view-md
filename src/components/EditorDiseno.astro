---
// src/components/EditorDiseno.astro
import TabEstilosWeb from './editor/TabEstilosWeb.astro';
import TabCaratula from './editor/TabCaratula.astro';
---

<aside id="editor-diseno-drawer" class="editor-drawer" aria-hidden="true">
  <!-- Cabecera del Inspector -->
  <div class="editor-header">
    <div class="editor-title-box">
      <h3>Inspector de Diseño</h3>
      <span class="editor-badge">Tokens en vivo</span>
    </div>
    <button type="button" id="btn-close-editor" class="editor-close-btn" aria-label="Cerrar Inspector">✕</button>
  </div>

  <div class="editor-body">
    <!-- Navegación de Pestañas -->
    <div class="editor-tabs">
      <button type="button" class="tab-btn active" data-tab="tab-estilo">Estilos Web & Prosa</button>
      <button type="button" class="tab-btn" data-tab="tab-caratula">Carátula & Cierre</button>
    </div>

    <!-- Pestaña 1: Acordeones de Estilos -->
    <TabEstilosWeb />

    <!-- Pestaña 2: Carátula y Lienzo Virtual -->
    <TabCaratula />
  </div>
</aside>

<script>
  import { setupEditorDrawer } from '../scripts/editor/editor-core';

  document.addEventListener('astro:page-load', () => {
    setupEditorDrawer();
  });
</script>