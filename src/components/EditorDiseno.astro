---
// src/components/EditorDiseno.astro
---

<aside id="editor-diseno-drawer" class="editor-drawer" aria-hidden="true">
  <!-- Cabecera del Inspector -->
  <div class="editor-header">
    <div class="editor-title-box">
      <h3>Inspector de Diseño</h3>
      <span class="editor-badge">Tokens en vivo</span>
    </div>
    <button type="button" id="btn-close-editor" class="editor-close-btn" aria-label="Cerrar Inspector">✕</button>
  </div>

  <div class="editor-body">
    <!-- Pestañas de Áreas -->
    <div class="editor-tabs">
      <button type="button" class="tab-btn active" data-tab="tab-estilo">Estilos Web</button>
      <button type="button" class="tab-btn" data-tab="tab-geometria">Párrafo</button>
      <button type="button" class="tab-btn" data-tab="tab-caratula">Carátula / Cierre</button>
    </div>

    <!-- PESTAÑA 1: ESTILOS WEB -->
    <div id="tab-estilo" class="tab-content active">
      <div class="control-card">
        <div class="control-row">
          <label for="ed-style-name">Nombre del Tema</label>
          <input type="text" id="ed-style-name" class="ed-input-text" value="Mi Tema Personalizado" />
        </div>
        <div class="control-row" style="margin-top: 0.5rem;">
          <label>Modo a calibrar</label>
          <div class="mode-switch-group">
            <button type="button" class="mode-btn active" id="btn-mode-claro">Modo Claro</button>
            <button type="button" class="mode-btn" id="btn-mode-oscuro">Modo Oscuro</button>
          </div>
        </div>
      </div>

      <!-- Fuentes Globales Base -->
      <div class="control-section-title">Tipografía General</div>
      <div class="control-card">
        <div class="control-row-col">
          <label for="font-doc">Fuente del Cuerpo (Párrafo)</label>
          <select id="font-doc" class="ed-select">
            <option value="system-ui, -apple-system, sans-serif">Sans-Serif (Sistema: Segoe UI, Roboto)</option>
            <option value="Georgia, Cambria, 'Times New Roman', serif">Serif Editorial (Georgia, Cambria)</option>
            <option value="'Times New Roman', Times, serif">Serif Clásica (Times New Roman)</option>
            <option value="'Fira Code', Consolas, monospace">Monospace (Fira Code, Código)</option>
          </select>
        </div>
      </div>

      <!-- Jerarquía Tipográfica Granular -->
      <div class="control-section-title">Encabezados: Fuentes, Alineación y Rayita</div>
      <div class="control-card">
        <!-- CONTROL H1 -->
        <div class="heading-block-editor">
          <div class="heading-header-row">
            <span class="heading-tag">H1</span>
            <input type="color" id="col-h1" value="#15803d" title="Color H1" />
            <div class="slider-field">
              <input type="range" id="size-h1" min="1.4" max="3.0" step="0.05" value="2.2" />
              <span class="slider-val" id="val-h1">2.2rem</span>
            </div>
          </div>

          <div class="heading-sub-controls">
            <select id="font-h1" class="ed-mini-select" title="Tipo de Letra para H1">
              <option value="var(--title-font)">Fuente por Defecto</option>
              <option value="system-ui, -apple-system, sans-serif">Sans-Serif (Moderno)</option>
              <option value="Georgia, Cambria, 'Times New Roman', serif">Serif (Editorial)</option>
              <option value="'Times New Roman', Times, serif">Times New Roman (Formal)</option>
              <option value="'Fira Code', monospace">Monospace (Técnico)</option>
            </select>

            <select id="align-h1" class="ed-mini-select" title="Alineación H1">
              <option value="left">Izquierda</option>
              <option value="center">Centro</option>
              <option value="right">Derecha</option>
            </select>

            <label class="switch-field-mini">
              <input type="checkbox" id="border-h1" checked />
              <span>Rayita</span>
            </label>
          </div>
        </div>

        <hr style="border: 0.5px solid var(--border-color); margin: 0.6rem 0;" />

        <!-- CONTROL H2 -->
        <div class="heading-block-editor">
          <div class="heading-header-row">
            <span class="heading-tag">H2</span>
            <input type="color" id="col-h2" value="#0f766e" title="Color H2" />
            <div class="slider-field">
              <input type="range" id="size-h2" min="1.2" max="2.4" step="0.05" value="1.8" />
              <span class="slider-val" id="val-h2">1.8rem</span>
            </div>
          </div>

          <div class="heading-sub-controls">
            <select id="font-h2" class="ed-mini-select" title="Tipo de Letra para H2">
              <option value="var(--title-font)">Fuente por Defecto</option>
              <option value="system-ui, -apple-system, sans-serif">Sans-Serif (Moderno)</option>
              <option value="Georgia, Cambria, 'Times New Roman', serif">Serif (Editorial)</option>
              <option value="'Times New Roman', Times, serif">Times New Roman (Formal)</option>
              <option value="'Fira Code', monospace">Monospace (Técnico)</option>
            </select>

            <select id="align-h2" class="ed-mini-select" title="Alineación H2">
              <option value="left">Izquierda</option>
              <option value="center">Centro</option>
              <option value="right">Derecha</option>
            </select>

            <label class="switch-field-mini">
              <input type="checkbox" id="border-h2" />
              <span>Rayita</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Ecuaciones KaTeX y Resaltado -->
      <div class="control-section-title">Ecuaciones KaTeX y Resaltado</div>
      <div class="control-card grid-colors">
        <div class="color-item">
          <label for="col-katex">Color Glifo KaTeX</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-katex" value="#0f172a" />
            <span class="color-hex" id="hex-katex">#0f172a</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-mark">Fondo Resaltado</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-mark" value="#eab308" />
            <span class="color-hex" id="hex-mark">#eab308</span>
          </div>
        </div>
      </div>

      <!-- Superficies y Acentos -->
      <div class="control-section-title">Superficies y Acentos</div>
      <div class="control-card grid-colors">
        <div class="color-item">
          <label for="col-bg">Fondo Principal</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-bg" value="#ffffff" />
            <span class="color-hex" id="hex-bg">#ffffff</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-header">Fondo Secundario</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-header" value="#f8fafc" />
            <span class="color-hex" id="hex-header">#f8fafc</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-border">Bordes</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-border" value="#e2e8f0" />
            <span class="color-hex" id="hex-border">#e2e8f0</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-accent">Color de Acento</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-accent" value="#8b5cf6" />
            <span class="color-hex" id="hex-accent">#8b5cf6</span>
          </div>
        </div>
      </div>

      <!-- Textos y Énfasis -->
      <div class="control-section-title">Colores de Prosa</div>
      <div class="control-card grid-colors">
        <div class="color-item">
          <label for="col-text">Texto Base</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-text" value="#0f172a" />
            <span class="color-hex" id="hex-text">#0f172a</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-bold">Negritas</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-bold" value="#020617" />
            <span class="color-hex" id="hex-bold">#020617</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-italic">Cursivas</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-italic" value="#16a34a" />
            <span class="color-hex" id="hex-italic">#16a34a</span>
          </div>
        </div>
        <div class="color-item">
          <label for="col-link">Enlaces</label>
          <div class="color-picker-wrap">
            <input type="color" id="col-link" value="#2563eb" />
            <span class="color-hex" id="hex-link">#2563eb</span>
          </div>
        </div>
      </div>

      <!-- Mermaid por Tipo -->
      <div class="control-section-title">Mermaid: Colores por Diagrama</div>
      <div class="control-card">
        <div class="control-row">
          <label><strong>Flowchart:</strong> Fondo Nodos</label>
          <input type="color" id="col-mm-flow-bg" value="#f8fafc" />
        </div>
        <div class="control-row" style="margin-top: 0.4rem;">
          <label><strong>Flowchart:</strong> Flechas / Bordes</label>
          <input type="color" id="col-mm-flow-line" value="#0284c7" />
        </div>
        <hr style="border: 0.5px solid var(--border-color); margin: 0.4rem 0;" />
        <div class="control-row">
          <label><strong>ER Diagram:</strong> Cabecera Entidad</label>
          <input type="color" id="col-mm-er-header" value="#e0f2fe" />
        </div>
        <div class="control-row" style="margin-top: 0.4rem;">
          <label><strong>ER Diagram:</strong> Bordes / Líneas</label>
          <input type="color" id="col-mm-er-border" value="#0ea5e9" />
        </div>
      </div>

      <button type="button" class="btn-export-json" id="btn-export-estilo">
        📋 Copiar JSON para estilos-base.json
      </button>
    </div>

    <!-- PESTAÑA 2: GEOMETRÍA Y PÁRRAFOS -->
    <div id="tab-geometria" class="tab-content">
      <div class="control-card">
        <div class="control-row">
          <label for="ed-geo-name">Nombre de Plantilla</label>
          <input type="text" id="ed-geo-name" class="ed-input-text" value="Formato Editorial Personalizado" />
        </div>
      </div>

      <div class="control-section-title">Comportamiento del Párrafo</div>
      <div class="control-card">
        <div class="control-row-col">
          <div class="label-with-val">
            <label for="geo-indent">Sangría de Primera Línea</label>
            <span id="val-indent">0 cm</span>
          </div>
          <input type="range" id="geo-indent" min="0.0" max="2.5" step="0.05" value="0" />
        </div>

        <div class="control-row-col" style="margin-top: 1rem;">
          <div class="label-with-val">
            <label for="geo-lineheight">Interlineado</label>
            <span id="val-lineheight">1.65</span>
          </div>
          <input type="range" id="geo-lineheight" min="1.2" max="2.2" step="0.05" value="1.65" />
        </div>

        <div class="control-row" style="margin-top: 1rem;">
          <label for="geo-align">Alineación de Texto</label>
          <select id="geo-align" class="ed-select">
            <option value="left">A la izquierda</option>
            <option value="justify">Justificado</option>
          </select>
        </div>
      </div>

      <button type="button" class="btn-export-json" id="btn-export-geometria">
        📋 Copiar JSON para plantillas-impresion.json
      </button>
    </div>

    <!-- PESTAÑA 3: CARÁTULAS Y CIERRES -->
    <div id="tab-caratula" class="tab-content">
      <div class="control-card">
        <div class="control-row">
          <label for="ed-cover-name">Nombre del Modelo</label>
          <input type="text" id="ed-cover-name" class="ed-input-text" value="Carátula Formal Pro" />
        </div>
      </div>

      <div class="control-section-title">Vista Previa en Vivo (Hoja Virtual)</div>
      <div class="cover-preview-wrapper">
        <div id="cover-live-canvas" class="cover-live-sheet"></div>
      </div>

      <div class="control-section-title">Diagramación de Elementos</div>
      <div class="control-card">
        <div class="control-row">
          <label for="cov-align">Alineación General</label>
          <select id="cov-align" class="ed-select">
            <option value="center">Centrado</option>
            <option value="left">Izquierda</option>
          </select>
        </div>

        <div class="control-row-col" style="margin-top: 0.8rem;">
          <div class="label-with-val">
            <label for="cov-logosize">Alto Máximo de Logo</label>
            <span id="val-logosize">40 mm</span>
          </div>
          <input type="range" id="cov-logosize" min="15" max="65" step="1" value="40" />
        </div>

        <div class="control-row-col" style="margin-top: 0.8rem;">
          <div class="label-with-val">
            <label for="cov-titlesize">Tamaño de Título</label>
            <span id="val-titlesize">14 pt</span>
          </div>
          <input type="range" id="cov-titlesize" min="10" max="22" step="0.5" value="14" />
        </div>

        <div class="control-row" style="margin-top: 0.8rem;">
          <label for="cov-transform">Transformación de Título</label>
          <select id="cov-transform" class="ed-select">
            <option value="uppercase">MAYÚSCULAS</option>
            <option value="none">Normal / Tal cual</option>
          </select>
        </div>
      </div>

      <div class="control-section-title">Bloques Visibles</div>
      <div class="control-card">
        <label class="switch-field">
          <input type="checkbox" id="cov-show-logo" checked />
          <span>Mostrar Escudo / Logotipo</span>
        </label>
        <label class="switch-field">
          <input type="checkbox" id="cov-show-docente" checked />
          <span>Mostrar Bloque de Docente</span>
        </label>
        <label class="switch-field">
          <input type="checkbox" id="cov-show-integrantes" checked />
          <span>Mostrar Bloque de Integrantes / Autor</span>
        </label>
        <label class="switch-field">
          <input type="checkbox" id="cov-show-pie" checked />
          <span>Mostrar Pie de Página (Ciudad / Año)</span>
        </label>
      </div>

      <button type="button" class="btn-export-json" id="btn-export-caratula">
        📋 Copiar JSON para caratulas.json
      </button>
    </div>
  </div>
</aside>

<script>
  import { setupEditorDrawer } from '../scripts/core/editor-diseno';
  document.addEventListener('astro:page-load', setupEditorDrawer);
</script>