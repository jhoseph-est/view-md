---
// src/components/taller/PanelImpresion.astro
interface Props {
  plantillasList: Array<[string, any]>;
}
const { plantillasList = [] } = Astro.props;
---
<div class="tab-panel" id="tab-print">
  <div class="preset-banner">
    <h3>Plantillas de Papel (plantillas-impresion.json)</h3>
    <p>Calibra márgenes físicos y formato de párrafo.</p>
  </div>

  <div class="control-box">
    <span class="control-box-title">Gestión de Plantillas</span>
    <div class="ctrl-field">
      <label>Plantilla Base</label>
      <select id="sel-print-preset" class="taller-select">
        {plantillasList.map(([k, v]: [string, any]) => (
          <option value={k}>{v.nombre || k}</option>
        ))}
      </select>
    </div>
    <div class="ctrl-field">
      <label>Nuevo ID</label>
      <input type="text" id="txt-print-new-id" class="taller-input" placeholder="ej. formato-monografia" />
    </div>
  </div>

  <div class="control-box">
    <span class="control-box-title">Márgenes de Hoja A4</span>
    <div class="ctrl-field-inline">
      <label>Margen Vertical (Sup/Inf)</label>
      <input type="range" id="rng-print-mv" min="1.0" max="3.5" step="0.1" value="2.54" />
      <span id="lbl-print-mv" class="val-badge">2.54cm</span>
    </div>
    <div class="ctrl-field-inline">
      <label>Margen Lateral (Izq/Der)</label>
      <input type="range" id="rng-print-mh" min="1.0" max="3.5" step="0.1" value="2.54" />
      <span id="lbl-print-mh" class="val-badge">2.54cm</span>
    </div>
  </div>

  <div class="control-box">
    <span class="control-box-title">Párrafo de Imprenta</span>
    <div class="ctrl-field-inline">
      <label>Sangría Primera Línea</label>
      <input type="range" id="rng-print-indent" min="0" max="2.5" step="0.1" value="1.27" />
      <span id="lbl-print-indent" class="val-badge">1.27cm</span>
    </div>
    <div class="ctrl-field">
      <label>Alineación de Texto</label>
      <select id="sel-print-align" class="taller-select">
        <option value="justify">Justificado</option>
        <option value="left">Alineado a la Izquierda</option>
      </select>
    </div>
  </div>

  <div class="action-btn-group">
    <button class="btn-taller-action btn-update" data-action="update" data-target="plantillasImpresion">
      Actualizar Plantilla
    </button>
    <button class="btn-taller-action btn-new-preset" data-action="create-new" data-target="plantillasImpresion">
      + Crear y Copiar Plantilla
    </button>
  </div>
</div>