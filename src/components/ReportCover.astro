---
// src/components/ReportCover.astro
import caratulasConfig from '../config/caratulas.json';

interface Integrante {
  nombre: string;
  codigo?: string;
  rol?: string;
}

interface Props {
  data: {
    title?: string;
    subtitulo?: string;
    institucion?: string;
    facultad?: string;
    escuela?: string;
    docente?: string;
    ciudad?: string;
    anio?: string | number;
    logo?: string;
    caratula?: string;
    integrantes?: Integrante[];
    author?: string;
    codigo?: string;
  };
}

const { data = {} } = Astro.props;

// Obtener modelo de carátula o fallback
const modeloId = data.caratula || 'uni-oficial';
const modelo = (caratulasConfig as Record<string, any>)[modeloId] || (caratulasConfig as Record<string, any>)['uni-oficial'] || {};

const logoPath = data.logo || modelo.logo?.ruta || "/assets/logos/logo-uni.png";
const logoHeight = modelo.logo?.altoMaximoMm ? `${modelo.logo.altoMaximoMm}mm` : "45mm";
const headerAlign = modelo.estructura?.alineacion || "center";
---

<article class="report-cover-page">
  <!-- 1. Membrete Institucional -->
  <header class="cover-header" style={`text-align: ${headerAlign};`}>
    <h2 class="inst-title">
      {data.institucion || "UNIVERSIDAD NACIONAL DE INGENIERÍA"}
    </h2>
    <p class="inst-faculty">
      {data.facultad || "FACULTAD DE INGENIERÍA MECÁNICA"}
    </p>
    <p class="inst-school">
      {data.escuela || "Escuela Profesional de Ingeniería Mecánica"}
    </p>
  </header>

  <!-- 2. Escudo / Logo Central -->
  <div class="cover-logo-container">
    <img 
      src={logoPath} 
      alt="Escudo Institucional" 
      style={`max-height: ${logoHeight}; height: ${logoHeight};`}
      class="cover-logo-img"
    />
  </div>

  <!-- 3. Título y Subtítulo del Documento -->
  <div class="cover-title-container">
    <h1 class="doc-main-title">
      {data.title || "TÍTULO DEL DOCUMENTO"}
    </h1>
    {data.subtitulo && (
      <p class="doc-subtitle">{data.subtitulo}</p>
    )}
  </div>

  <!-- 4. Bloque de Integrantes / Autor / Docente -->
  <div class="cover-metadata-container">
    <table class="cover-meta-table">
      <tbody>
        {data.docente && (
          <tr>
            <td class="meta-label">DOCENTE:</td>
            <td class="meta-value">{data.docente}</td>
          </tr>
        )}
        {data.integrantes && data.integrantes.length > 0 ? (
          data.integrantes.map((m: Integrante, idx: number) => (
            <tr>
              <td class="meta-label">{idx === 0 ? "INTEGRANTES:" : ""}</td>
              <td class="meta-value">
                <span class="member-name">{m.nombre}</span>
                {m.codigo && <span class="member-code"> ({m.codigo})</span>}
                {m.rol && <span class="member-rol"> — <em>{m.rol}</em></span>}
              </td>
            </tr>
          ))
        ) : data.author ? (
          <tr>
            <td class="meta-label">AUTOR:</td>
            <td class="meta-value">
              {data.author} {data.codigo ? `(${data.codigo})` : ''}
            </td>
          </tr>
        ) : null}
      </tbody>
    </table>
  </div>

  <!-- 5. Pie de Página (Ciudad y Año) -->
  <footer class="cover-footer">
    <p class="city-text">{data.ciudad || "LIMA — PERÚ"}</p>
    <p class="year-text">{data.anio || "2026"}</p>
  </footer>
</article>

<style>
  .report-cover-page {
    box-sizing: border-box;
    width: 100%;
    min-height: 230mm;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    background: #ffffff;
    color: #000000;
  }
  .cover-header { width: 100%; }
  .inst-title {
    font-size: 13pt;
    margin: 0;
    text-transform: uppercase;
    font-weight: 800;
    line-height: 1.3;
  }
  .inst-faculty {
    font-size: 10.5pt;
    margin: 0.3rem 0;
    font-weight: 700;
  }
  .inst-school {
    font-size: 9.5pt;
    margin: 0;
    opacity: 0.85;
  }
  .cover-logo-container {
    margin: 2rem auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .cover-logo-img {
    object-fit: contain;
    width: auto;
  }
  .cover-title-container {
    margin: 1rem 0;
    max-width: 90%;
  }
  .doc-main-title {
    font-size: 15pt;
    text-transform: uppercase;
    margin: 0.4rem 0;
    font-weight: 800;
    line-height: 1.3;
  }
  .doc-subtitle {
    font-size: 10.5pt;
    font-style: italic;
    margin: 0.2rem 0 0 0;
    opacity: 0.85;
  }
  .cover-metadata-container {
    width: 100%;
    margin-top: auto;
    margin-bottom: 2rem;
  }
  .cover-meta-table {
    width: 85%;
    margin: 0 auto;
    border: none;
    border-collapse: collapse;
    font-size: 9.5pt;
  }
  .cover-meta-table td {
    border: none !important;
    padding: 0.2rem 0.5rem;
  }
  .meta-label {
    text-align: left;
    font-weight: 700;
    width: 25%;
    vertical-align: top;
  }
  .meta-value {
    text-align: right;
    vertical-align: top;
  }
  .member-rol { font-size: 0.85em; opacity: 0.85; }
  .cover-footer {
    width: 100%;
    text-align: center;
  }
  .city-text {
    font-size: 9.5pt;
    font-weight: 700;
    margin: 0;
  }
  .year-text {
    font-size: 9.5pt;
    margin: 0.15rem 0 0 0;
  }
</style>