---
// src/components/Breadcrumbs.astro
import { formatName } from '../utils/fileTree';

interface Props {
  title?: string;
}

interface CrumbItem {
  name: string;
  url: string;
  isLast: boolean;
}

const { title = 'Documento' } = Astro.props;
const pathname = Astro.url.pathname.replace(/^\/|\/$/g, '');
const segments: string[] = pathname ? pathname.split('/') : [];

// Omitimos el prefijo 'docs' si existe en la ruta
const breadcrumbSegments: string[] = segments[0] === 'docs' ? segments.slice(1) : segments;

let accumulatedPath = '/docs';
const crumbs: CrumbItem[] = breadcrumbSegments.map((segment: string, index: number): CrumbItem => {
  accumulatedPath += `/${segment}`;
  const isLast = index === breadcrumbSegments.length - 1;
  return {
    name: isLast ? title : formatName(segment),
    url: accumulatedPath,
    isLast
  };
});
---

<nav class="breadcrumbs" aria-label="Migas de pan">
  <a href="/" class="crumb-link home-crumb" title="Inicio del Jardín">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <span>Home</span>
  </a>

  {crumbs.map((crumb: CrumbItem) => (
    <span class="crumb-item">
      <span class="crumb-sep">›</span>
      {crumb.isLast ? (
        <span class="crumb-current" aria-current="page">{crumb.name}</span>
      ) : (
        <a href={crumb.url} class="crumb-link">{crumb.name}</a>
      )}
    </span>
  ))}
</nav>