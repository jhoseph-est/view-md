---
// src/components/DocReportHeader.astro
interface Integrante {
  nombre: string;
  codigo?: string;
  rol?: string;
}

export interface Props {
  data: Record<string, any>;
}

const { data } = Astro.props;

// Claves que no deben mostrarse como metadatos sueltos
const omitKeys = new Set([
  'title', 'subtitulo', 'draft', 'slides', 'orden', 'mostrarIndice', 
  'mostrarNav', 'mostrarCabecera', 'target', 'theme', 'plantilla', 
  'caratula', 'icon', 'tags'
]);

const institucion = data.institucion || '';
const facultad = data.facultad || '';
const escuela = data.escuela || '';
const subtitulo = data.subtitulo || '';

// Filtrar propiedades adicionales no omitidas
const extraEntries = Object.entries(data).filter(([k, v]) => {
  if (omitKeys.has(k)) return false;
  if (['institucion', 'facultad', 'escuela', 'docente', 'integrantes', 'author', 'codigo'].includes(k)) return false;
  return v !== undefined && v !== null && v !== '';
});
---

<div class="doc-report-header">
  {(institucion || facultad) && (
    <div class="header-banner">
      <div class="inst-info">
        {institucion && <span class="inst-name">{institucion}</span>}
        {facultad && <span class="inst-dot">·</span><span class="faculty-name">{facultad}</span>}
        {escuela && <span class="inst-dot">·</span><span class="school-name">{escuela}</span>}
      </div>
    </div>
  )}

  {subtitulo && <p class="report-subtitle">{subtitulo}</p>}

  <div class="report-meta-grid">
    {data.docente && (
      <div class="meta-item">
        <span class="meta-label">Docente:</span>
        <span class="meta-value">{data.docente}</span>
      </div>
    )}

    {data.author && !data.integrantes && (
      <div class="meta-item">
        <span class="meta-label">Autor:</span>
        <span class="meta-value">{data.author} {data.codigo ? `(${data.codigo})` : ''}</span>
      </div>
    )}

    {/* Renderizado dinámico de campos personalizados del YAML */}
    {extraEntries.map(([key, val]) => (
      <div class="meta-item">
        <span class="meta-label">{key}:</span>
        <span class="meta-value">
          {Array.isArray(val) 
            ? val.join(', ') 
            : typeof val === 'object' 
              ? JSON.stringify(val) 
              : String(val)}
        </span>
      </div>
    ))}
  </div>

  {data.integrantes && data.integrantes.length > 0 && (
    <div class="integrantes-container">
      <span class="meta-label">Integrantes / Equipo:</span>
      <ul class="integrantes-list">
        {data.integrantes.map((m: Integrante) => (
          <li class="integrante-item">
            <span class="item-name">{m.nombre}</span>
            {m.codigo && <span class="item-code">({m.codigo})</span>}
            {m.rol && <span class="item-role">— {m.rol}</span>}
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .doc-report-header {
    background-color: var(--report-card-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--report-card-border, var(--border-color));
    border-radius: var(--report-card-radius, 8px);
    padding: var(--report-card-padding, 1rem 1.25rem);
    margin: 1rem 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .header-banner {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .inst-info {
    font-family: var(--report-banner-font, var(--ui-font));
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--report-banner-color, var(--accent-color));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .inst-dot { opacity: 0.5; }

  .report-subtitle {
    margin: 0;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--report-subtitle-color, var(--text-color));
    opacity: 0.85;
  }

  .report-meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.82rem;
  }

  .meta-item {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .meta-label {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--report-label-color, var(--text-muted));
  }

  .meta-value {
    color: var(--report-value-color, var(--text-color));
    font-weight: 600;
  }

  .integrantes-container {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .integrantes-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .integrante-item {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--text-color);
    padding-left: 1rem;
    position: relative;
  }

  .integrante-item::before {
    content: "•";
    position: absolute;
    left: 0.2rem;
    color: var(--report-bullet-color, var(--accent-color));
    font-size: 1rem;
    line-height: 1;
  }

  .item-name { font-weight: 600; }
  .item-code {
    font-family: 'Fira Code', monospace;
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .item-role {
    font-size: 0.75rem;
    color: var(--accent-color);
    font-style: italic;
  }
</style>