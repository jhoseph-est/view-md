---
// src/components/GlobalModal.astro
---
<div id="global-modal" class="global-modal-overlay">
  <div class="global-modal-content">
    <div class="global-modal-header">
      <div>
        <h3 id="global-modal-title" class="global-modal-title">Título</h3>
        <p id="global-modal-subtitle" class="global-modal-subtitle"></p>
      </div>
      <button id="global-modal-close" class="global-modal-close-btn" aria-label="Cerrar modal">
        Cerrar
      </button>
    </div>
    <div id="global-modal-body" class="global-modal-body">
      <!-- Contenido dinámico -->
    </div>
  </div>
</div>

<style>
  .global-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .global-modal-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .global-modal-content {
    width: 95vw;
    height: 90vh;
    background-color: var(--bg-color);
    color: var(--text-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transform: scale(0.96);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .global-modal-overlay.is-active .global-modal-content {
    transform: scale(1);
  }

  .global-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--header-bg);
  }

  .global-modal-title { 
    margin: 0; 
    color: #8b5cf6; 
    font-size: 1.1rem; 
    font-family: var(--ui-font);
  }

  .global-modal-subtitle { 
    margin: 0; 
    opacity: 0.7; 
    font-size: 0.85rem; 
    color: var(--text-color); 
    font-family: var(--ui-font);
  }

  .global-modal-body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: auto;
    position: relative;
    box-sizing: border-box;
    background-color: var(--bg-color);
  }

  .global-modal-close-btn {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.85rem;
    font-family: var(--ui-font);
    transition: all 0.2s ease;
  }

  .global-modal-close-btn:hover {
    background: #ef4444;
    color: white;
  }
</style>