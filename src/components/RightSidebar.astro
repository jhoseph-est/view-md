---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface TocItem extends Heading {
  children: TocItem[];
}

interface Props {
  headings?: Heading[];
  frontmatter?: any;
}

const { headings = [], frontmatter = {} } = Astro.props;

function buildToc(flatHeadings: Heading[]): TocItem[] {
  const toc: TocItem[] = [];
  const parentStack: TocItem[] = [];
  if (!Array.isArray(flatHeadings)) return toc;

  flatHeadings.forEach((h) => {
    if (!h || !h.slug || !h.text) return;
    const item: TocItem = { ...h, children: [] };
    while (parentStack.length > 0 && parentStack[parentStack.length - 1].depth >= item.depth) {
      parentStack.pop();
    }
    if (parentStack.length === 0) {
      toc.push(item);
    } else {
      parentStack[parentStack.length - 1].children.push(item);
    }
    parentStack.push(item);
  });
  return toc;
}

const tocTree = buildToc(headings);
---

<!-- 1. BLOQUE INDEPENDIENTE: ÍNDICE (2/3 SUPERIOR) -->
<aside class="independent-panel top-toc" id="sec-toc" aria-label="Índice de Contenidos">
  <div class="panel-header">ÍNDICE</div>
  <div class="panel-body">
    {tocTree.length > 0 ? (
      <ul class="r-toc-list">
        {tocTree.map((h1) => (
          <li>
            <a href={`#${h1.slug}`} class="r-toc-item" title={h1.text}>
              <span class="toc-hash">#</span>
              <span class="text-truncate">{h1.text}</span>
            </a>
            {h1.children.length > 0 && (
              <ul class="r-toc-nested">
                {h1.children.map((h2) => (
                  <li>
                    <a href={`#${h2.slug}`} class="r-toc-item sub" title={h2.text}>
                      <span class="toc-hash">#</span>
                      <span class="text-truncate">{h2.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">Sin subtítulos</p>
    )}
  </div>
</aside>

<!-- 2. BLOQUE INDEPENDIENTE: METADATOS (1/3 INFERIOR) -->
<aside class="independent-panel bottom-meta" id="sec-meta" aria-label="Metadatos">
  <div class="panel-header">METADATOS</div>
  <div class="panel-body">
    <div class="meta-row">
      <span class="meta-k">Fecha:</span>
      <span class="meta-v">{frontmatter.date ? new Date(frontmatter.date).toLocaleDateString() : '—'}</span>
    </div>
    {frontmatter.author && (
      <div class="meta-row">
        <span class="meta-k">Autor:</span>
        <span class="meta-v">{frontmatter.author}</span>
      </div>
    )}
    {frontmatter.readingTime && (
      <div class="meta-row">
        <span class="meta-k">Lectura:</span>
        <span class="meta-v">{frontmatter.readingTime} min</span>
      </div>
    )}
    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="meta-row tags-row">
        <span class="meta-k">Tags:</span>
        <div class="meta-tags">
          {frontmatter.tags.map((t: string) => (
            <span class="tag-pill">#{t}</span>
          ))}
        </div>
      </div>
    )}
  </div>
</aside>

<style>
  /* Contenedores físicos independientes anclados a la derecha */
  .independent-panel {
    position: absolute;
    right: 0;
    width: 260px;
    background: var(--header-bg);
    border-left: 1px solid var(--border-color);
    z-index: 40;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  /* 2/3 superior fijo */
  .top-toc {
    top: 0;
    height: 66.666vh;
    border-bottom: 1px solid var(--border-color);
  }

  /* 1/3 inferior fijo */
  .bottom-meta {
    bottom: 0;
    height: 33.334vh;
  }

  /* Clases individuales de ocultamiento por CSS */
  :global(html.no-toc) #sec-toc {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  :global(html.no-meta) #sec-meta {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  .panel-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #8b5cf6;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 1rem;
  }

  .r-toc-list, .r-toc-nested { list-style: none !important; padding: 0 !important; margin: 0 !important; }
  .r-toc-nested { margin-left: 0.6rem !important; border-left: 1px solid var(--border-color); padding-left: 0.3rem !important; }
  .r-toc-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.35rem;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.8rem;
    opacity: 0.8;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .r-toc-item:hover { opacity: 1; background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
  .toc-hash { color: #8b5cf6; font-size: 0.75rem; font-weight: bold; }
  .text-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }

  .meta-row { display: flex; justify-content: space-between; font-size: 0.78rem; margin-bottom: 0.4rem; }
  .meta-k { opacity: 0.6; font-weight: 500; }
  .meta-v { font-weight: 600; }
  .tags-row { flex-direction: column; gap: 0.25rem; margin-top: 0.5rem; }
  .meta-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .tag-pill { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; padding: 1px 5px; border-radius: 4px; font-size: 0.7rem; }
  .empty-note { font-size: 0.75rem; opacity: 0.5; font-style: italic; margin: 0; }
</style>