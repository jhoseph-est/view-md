---
// src/components/RightSidebar.astro
import { getCollection, type CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  frontmatter?: any;
}

const { headings = [], frontmatter = {} } = Astro.props;

const allDocs = await getCollection('docs');
const currentPath = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '');

const currentDoc = allDocs.find((doc: CollectionEntry<'docs'>) => {
  const docPath = `/docs/${doc.id.replace(/\\/g, '/')}`;
  return docPath === currentPath;
});

const docBody = currentDoc?.body || '';

function sanitizeBody(rawText: string): string {
  return rawText
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]*?`/g, '')
    .replace(/\$\$[\s\S]*?\$\$/g, '')
    .replace(/\$[^$]*?\$/g, '');
}

const cleanCurrentDocBody = sanitizeBody(docBody);

// 1. Enlaces Salientes (Outlinks)
const outlinks: { title: string; url: string }[] = [];
const seenOutlinks = new Set<string>();

if (cleanCurrentDocBody) {
  const mdLinkRegex = /\[(?:[^\]]+)\]\(([^)#\s]+)(?:#[^)]*)?\)/g;
  const wikiLinkRegex = /\[\[([a-zA-Z0-9_\-\/]+)(?:\Vert{}.*?)?\]\]/g;
  let match: RegExpExecArray | null;

  while ((match = mdLinkRegex.exec(cleanCurrentDocBody)) !== null) {
    const rawTarget = match[1].trim().replace(/\/$/, '');
    const targetUrl = rawTarget.startsWith('/docs/') ? rawTarget : `/docs/${rawTarget}`;
    
    if (targetUrl !== currentPath && !seenOutlinks.has(targetUrl)) {
      const targetDoc = allDocs.find((d: CollectionEntry<'docs'>) => {
        const p = `/docs/${d.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '')}`;
        return p.toLowerCase() === targetUrl.toLowerCase();
      });
      if (targetDoc) {
        seenOutlinks.add(targetUrl);
        outlinks.push({ title: targetDoc.data.title, url: targetUrl });
      }
    }
  }

  while ((match = wikiLinkRegex.exec(cleanCurrentDocBody)) !== null) {
    const cleanSlug = match[1].replace(/\\/g, '/').replace(/^\/docs\//, '').replace(/\/$/, '');
    const targetUrl = `/docs/${cleanSlug}`;
    
    if (targetUrl !== currentPath && !seenOutlinks.has(targetUrl)) {
      const targetDoc = allDocs.find((d: CollectionEntry<'docs'>) => {
        const idPath = d.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '');
        return idPath.toLowerCase() === cleanSlug.toLowerCase() ||
               d.data.title.toLowerCase() === cleanSlug.toLowerCase();
      });
      if (targetDoc) {
        seenOutlinks.add(targetUrl);
        outlinks.push({ title: targetDoc.data.title, url: targetUrl });
      }
    }
  }
}

// 2. Backlinks
const backlinks: { title: string; url: string }[] = [];
const currentCleanSlug = currentPath.replace(/^\/docs\//, '').toLowerCase();
const currentDocTitle = (frontmatter.title || '').trim().toLowerCase();

allDocs.forEach((otherDoc: CollectionEntry<'docs'>) => {
  const otherPath = `/docs/${otherDoc.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '')}`;
  if (otherPath.toLowerCase() === currentPath.toLowerCase() || !otherDoc.body) return;

  const cleanBody = sanitizeBody(otherDoc.body).toLowerCase();
  const hasMarkdownLink = 
    cleanBody.includes(`(/docs/${currentCleanSlug})`) || 
    cleanBody.includes(`(${currentCleanSlug})`);
  const hasWikiLinkBySlug = 
    cleanBody.includes(`[[${currentCleanSlug}]]`) || 
    cleanBody.includes(`[[${currentCleanSlug}|`) ||
    cleanBody.includes(`[[/docs/${currentCleanSlug}]]`) ||
    cleanBody.includes(`[[/docs/${currentCleanSlug}|`);
  const hasWikiLinkByTitle = currentDocTitle ? (
    cleanBody.includes(`[[${currentDocTitle}]]`) || 
    cleanBody.includes(`[[${currentDocTitle}|`)
  ) : false;

  if (hasMarkdownLink || hasWikiLinkBySlug || hasWikiLinkByTitle) {
    backlinks.push({
      title: otherDoc.data.title,
      url: otherPath
    });
  }
});

const allHeadings = headings.filter((h: Heading) => Boolean(h && h.slug && h.text && h.depth >= 1 && h.depth <= 6));

// 3. Normalización y filtrado exhaustivo de todos los Metadatos
const ignoredKeys = new Set(['theme', 'slides', 'mostrarIndice', 'mostrarNav', 'mostrarCabecera', 'draft', 'contributors']);

const rawEntries = Object.entries(frontmatter).filter(([k, v]) => {
  return !ignoredKeys.has(k) && v !== undefined && v !== null && v !== '';
});

const priorityOrder: Record<string, number> = {
  title: 1,
  subtitulo: 2,
  institucion: 3,
  facultad: 4,
  escuela: 5,
  docente: 6,
  date: 7,
  readingTime: 8,
  integrantes: 99
};

const cleanEntries = rawEntries.sort(([a], [b]) => {
  const pA = priorityOrder[a] ?? 50;
  const pB = priorityOrder[b] ?? 50;
  return pA - pB;
});

function formatMetaValue(val: any): string {
  if (val instanceof Date) return val.toLocaleDateString('es-PE');
  if (typeof val === 'boolean') return val ? 'Sí' : 'No';
  return String(val);
}

function formatKeyLabel(key: string): string {
  const customLabels: Record<string, string> = {
    title: 'TÍTULO',
    subtitulo: 'SUBTÍTULO',
    institucion: 'INSTITUCIÓN',
    facultad: 'FACULTAD',
    escuela: 'ESCUELA',
    docente: 'DOCENTE',
    ciudad: 'CIUDAD',
    anio: 'AÑO',
    logo: 'LOGO',
    readingTime: 'LECTURA',
    date: 'FECHA',
    updated: 'ACTUALIZADO',
    orden: 'ORDEN',
    tags: 'ETIQUETAS',
    integrantes: 'INTEGRANTES'
  };
  return customLabels[key] || key.toUpperCase();
}
---

<!-- 1. ÍNDICE (TOP) -->
<aside class="independent-panel top-toc" id="sec-toc" aria-label="Índice de Contenidos">
  <div class="panel-header">ÍNDICE</div>
  <div class="panel-body" id="toc-body">
    {allHeadings.length > 0 ? (
      <ul class="r-toc-list">
        {allHeadings.map((h: Heading) => (
          <li class={`r-toc-entry depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="r-toc-item" data-slug={h.slug} title={h.text}>
              <span class="toc-hash">#</span>
              <span class="text-truncate">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">Sin subtítulos</p>
    )}
  </div>
</aside>

<!-- 2. METADATOS (BOTTOM) -->
<aside class="independent-panel bottom-meta" id="sec-meta" aria-label="Metadatos">
  <div class="panel-header meta-panel-header">
    <span>METADATOS</span>
    <button type="button" id="btn-expand-meta" class="meta-expand-btn" title="Ampliar Metadatos (Vista Completa)">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 3h6v6"></path>
        <path d="M9 21H3v-6"></path>
        <path d="M21 3l-7 7"></path>
        <path d="M3 21l7-7"></path>
      </svg>
    </button>
  </div>
  <div class="panel-body meta-scroll-area" id="meta-container">
    {cleanEntries.length > 0 ? (
      <div class="meta-list-wrapper">
        {cleanEntries.map(([key, value]) => {
          // Caso 1: Integrantes / Equipo
          if (key === 'integrantes' && Array.isArray(value)) {
            return (
              <div class="meta-block">
                <span class="meta-k">{formatKeyLabel(key)}:</span>
                <ul class="meta-sublist">
                  {value.map((integ: any) => (
                    <li class="meta-subitem">
                      <strong class="item-name">{integ.nombre || integ}</strong>
                      {integ.codigo && <span class="meta-code">({integ.codigo})</span>}
                      {integ.rol && <span class="meta-role">— {integ.rol}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            );
          }

          // Caso 2: Tags
          if (key === 'tags' && Array.isArray(value)) {
            return (
              <div class="meta-row tags-row">
                <span class="meta-k">{formatKeyLabel(key)}:</span>
                <div class="meta-tags">
                  {value.map((t: string) => (
                    <a href={`/docs/explorar?search=%23${encodeURIComponent(String(t))}`} class="tag-pill" title={`Filtrar por #${t}`}>
                      #{t}
                    </a>
                  ))}
                </div>
              </div>
            );
          }

          // Caso 3: Autor con enlace
          if (key === 'author') {
            return (
              <div class="meta-row">
                <span class="meta-k">AUTOR:</span>
                <a href={`/docs/explorar?search=%40${encodeURIComponent(String(value))}`} class="meta-v meta-link" title={`Ver más de ${value}`}>
                  {value}
                </a>
              </div>
            );
          }

          // Caso 4: Tiempo de lectura
          if (key === 'readingTime') {
            return (
              <div class="meta-row">
                <span class="meta-k">LECTURA:</span>
                <span class="meta-v">{value} min</span>
              </div>
            );
          }

          // Caso 5: Arreglos regulares
          if (Array.isArray(value)) {
            return (
              <div class="meta-row">
                <span class="meta-k">{formatKeyLabel(key)}:</span>
                <span class="meta-v">{value.join(', ')}</span>
              </div>
            );
          }

          // Caso 6: Escalares estándar
          return (
            <div class="meta-row">
              <span class="meta-k">{formatKeyLabel(key)}:</span>
              <span class="meta-v">{formatMetaValue(value)}</span>
            </div>
          );
        })}

        {outlinks.length > 0 && (
          <div class="meta-block">
            <span class="meta-k">ENLACES SALIENTES:</span>
            <ul class="meta-link-list">
              {outlinks.map(link => (
                <li><a href={link.url} class="doc-link-item" title={link.title}>🔗 {link.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        {backlinks.length > 0 && (
          <div class="meta-block">
            <span class="meta-k">BACKLINKS:</span>
            <ul class="meta-link-list">
              {backlinks.map(bl => (
                <li><a href={bl.url} class="doc-link-item" title={bl.title}>🔗 {bl.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    ) : (
      <p class="empty-note">Sin metadatos registrados.</p>
    )}
  </div>
</aside>

<script>
  let currentScrollCleanup: (() => void) | null = null;

  function setupRightSidebar() {
    // Si había un escuchador previo de la página anterior, cancelarlo inmediatamente
    if (currentScrollCleanup) {
      currentScrollCleanup();
      currentScrollCleanup = null;
    }

    const scrollContainer = document.getElementById('main-scroll-container');
    const tocContainer = document.getElementById('toc-body');
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.r-toc-item'));

    if (scrollContainer && tocLinks.length) {
      const headingPairs = tocLinks
        .map((link) => {
          const slug = link.getAttribute('data-slug');
          const target = slug ? document.getElementById(slug) : null;
          return { link, target, slug };
        })
        .filter((p): p is { link: HTMLAnchorElement; target: HTMLElement; slug: string } => p.target !== null);

      if (headingPairs.length) {
        let activeLink: HTMLAnchorElement | null = null;
        let isProgrammaticScroll = false;
        let scrollEndTimer: number | undefined;
        let isDestroyed = false;

        const setActive = (item: { link: HTMLAnchorElement; slug: string }, updateHash = true) => {
          if (isDestroyed) return;
          if (activeLink === item.link) return;
          if (activeLink) activeLink.classList.remove('active-heading');
          item.link.classList.add('active-heading');
          activeLink = item.link;

          if (tocContainer) {
            const linkTop = item.link.offsetTop;
            const containerScroll = tocContainer.scrollTop;
            const containerHeight = tocContainer.clientHeight;
            if (linkTop < containerScroll + 30 || linkTop > containerScroll + containerHeight - 50) {
              tocContainer.scrollTo({ top: linkTop - 50, behavior: 'smooth' });
            }
          }

          // Solo actualizar el hash si no es scroll programático y seguimos en la misma ruta
          if (updateHash && !isProgrammaticScroll && !isDestroyed) {
            const newHash = `#${item.slug}`;
            if (window.location.hash !== newHash) {
              // Validar que el pathname actual corresponda antes de reemplazar el estado
              history.replaceState(null, '', `${window.location.pathname}${newHash}`);
            }
          }
        };

        const calculateActiveHeading = () => {
          if (!scrollContainer || isProgrammaticScroll || isDestroyed) return;
          const scrollTop = scrollContainer.scrollTop;
          const scrollHeight = scrollContainer.scrollHeight;
          const clientHeight = scrollContainer.clientHeight;

          if (scrollTop + clientHeight >= scrollHeight - 15) {
            setActive(headingPairs[headingPairs.length - 1], true);
            return;
          }

          const FOCAL_OFFSET = 100;
          let selected = headingPairs[0];
          for (let i = 0; i < headingPairs.length; i++) {
            const distance = headingPairs[i].target.offsetTop - scrollTop;
            if (distance <= FOCAL_OFFSET) {
              selected = headingPairs[i];
            } else {
              break;
            }
          }
          setActive(selected, true);
        };

        let ticking = false;
        const onScroll = () => {
          if (isDestroyed) return;
          if (isProgrammaticScroll) {
            window.clearTimeout(scrollEndTimer);
            scrollEndTimer = window.setTimeout(() => {
              isProgrammaticScroll = false;
            }, 120);
            return;
          }
          if (!ticking) {
            window.requestAnimationFrame(() => {
              calculateActiveHeading();
              ticking = false;
            });
            ticking = true;
          }
        };

        scrollContainer.addEventListener('scroll', onScroll, { passive: true });

        headingPairs.forEach((item) => {
          item.link.addEventListener('click', (e) => {
            e.preventDefault();
            isProgrammaticScroll = true;
            window.clearTimeout(scrollEndTimer);
            setActive(item, false);
            history.replaceState(null, '', `${window.location.pathname}#${item.slug}`);

            const targetTop = item.target.offsetTop - 30;
            scrollContainer.scrollTo({
              top: targetTop,
              behavior: 'smooth'
            });

            scrollEndTimer = window.setTimeout(() => {
              isProgrammaticScroll = false;
            }, 600);
          });
        });

        calculateActiveHeading();

        // Función de limpieza para cuando salgamos de esta página
        currentScrollCleanup = () => {
          isDestroyed = true;
          scrollContainer.removeEventListener('scroll', onScroll);
          window.clearTimeout(scrollEndTimer);
        };
      }
    }

    // Modal Expandido de Metadatos
    const btnExpand = document.getElementById('btn-expand-meta');
    const metaContainer = document.getElementById('meta-container');

    if (btnExpand && metaContainer) {
      btnExpand.onclick = () => {
        const clonedContent = metaContainer.cloneNode(true) as HTMLElement;
        clonedContent.classList.add('meta-modal-expanded');

        window.dispatchEvent(new CustomEvent('open-global-modal', {
          detail: {
            title: 'Metadatos del Documento',
            subtitle: 'Propiedades, asignaciones y parámetros registrados',
            contentHTML: clonedContent
          }
        }));
      };
    }
  }

  // Cancelar tareas pendientes justo antes de que Astro intercambie el DOM
  document.addEventListener('astro:before-swap', () => {
    if (currentScrollCleanup) {
      currentScrollCleanup();
      currentScrollCleanup = null;
    }
  });

  document.addEventListener('astro:page-load', setupRightSidebar);
</script>