---
// src/components/RightSidebar.astro
import { getCollection, type CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface TocItem extends Heading {
  children: TocItem[];
}

interface Props {
  headings?: Heading[];
  frontmatter?: any;
}

const { headings = [], frontmatter = {} } = Astro.props;

// Obtener todos los documentos
const allDocs = await getCollection('docs');
const currentPath = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '');

// Encontrar el documento actual dentro de la colección para leer su cuerpo (body)
const currentDoc = allDocs.find((doc: CollectionEntry<'docs'>) => {
  const docPath = `/docs/${doc.id.replace(/\\/g, '/')}`;
  return docPath === currentPath;
});

const docBody = currentDoc?.body || '';

// 1. Enlaces Salientes (Outlinks): Extraídos automáticamente del texto Markdown actual
const outlinks: { title: string; url: string }[] = [];
const seenOutlinks = new Set<string>();

if (docBody) {
  const mdLinkRegex = /\[.*?\]\((\/docs\/[^)#]+)(?:#[^)]+)?\)/g;
  const wikiLinkRegex = /\[\[([a-zA-Z0-9_\-\/]+)(?:\#.*?)?(?:\Vert{}.*?)?\]\]/g;

  let match: RegExpExecArray | null;
  while ((match = mdLinkRegex.exec(docBody)) !== null) {
    const targetUrl = match[1].replace(/\/$/, '');
    if (targetUrl !== currentPath && !seenOutlinks.has(targetUrl)) {
      const targetDoc = allDocs.find((d: CollectionEntry<'docs'>) => `/docs/${d.id.replace(/\\/g, '/')}` === targetUrl);
      if (targetDoc) {
        seenOutlinks.add(targetUrl);
        outlinks.push({ title: targetDoc.data.title, url: targetUrl });
      }
    }
  }

  while ((match = wikiLinkRegex.exec(docBody)) !== null) {
    const targetUrl = `/docs/${match[1].replace(/\\/g, '/')}`.replace(/\/$/, '');
    if (targetUrl !== currentPath && !seenOutlinks.has(targetUrl)) {
      const targetDoc = allDocs.find((d: CollectionEntry<'docs'>) => `/docs/${d.id.replace(/\\/g, '/')}` === targetUrl);
      if (targetDoc) {
        seenOutlinks.add(targetUrl);
        outlinks.push({ title: targetDoc.data.title, url: targetUrl });
      }
    }
  }
}

// 2. Backlinks automáticos (documentos que enlazan hacia este apunte)
const backlinks: { title: string; url: string }[] = [];
allDocs.forEach((doc: CollectionEntry<'docs'>) => {
  const docPath = `/docs/${doc.id.replace(/\\/g, '/')}`;
  if (docPath !== currentPath && doc.body) {
    if (doc.body.includes(currentPath) || (frontmatter.title && doc.body.includes(frontmatter.title))) {
      backlinks.push({
        title: doc.data.title,
        url: docPath
      });
    }
  }
});

function buildToc(flatHeadings: Heading[]): TocItem[] {
  const toc: TocItem[] = [];
  const parentStack: TocItem[] = [];
  if (!Array.isArray(flatHeadings)) return toc;

  flatHeadings.forEach((h) => {
    if (!h || !h.slug || !h.text) return;
    const item: TocItem = { ...h, children: [] };
    while (parentStack.length > 0 && parentStack[parentStack.length - 1].depth >= item.depth) {
      parentStack.pop();
    }
    if (parentStack.length === 0) {
      toc.push(item);
    } else {
      parentStack[parentStack.length - 1].children.push(item);
    }
    parentStack.push(item);
  });
  return toc;
}

const tocTree = buildToc(headings);
---

<!-- 1. BLOQUE INDEPENDIENTE: ÍNDICE (2/3 SUPERIOR) -->
<aside class="independent-panel top-toc" id="sec-toc" aria-label="Índice de Contenidos">
  <div class="panel-header">ÍNDICE</div>
  <div class="panel-body" id="toc-body">
    {tocTree.length > 0 ? (
      <ul class="r-toc-list">
        {tocTree.map((h1) => (
          <li>
            <a href={`#${h1.slug}`} class="r-toc-item" data-slug={h1.slug} title={h1.text}>
              <span class="toc-hash">#</span>
              <span class="text-truncate">{h1.text}</span>
            </a>
            {h1.children.length > 0 && (
              <ul class="r-toc-nested">
                {h1.children.map((h2) => (
                  <li>
                    <a href={`#${h2.slug}`} class="r-toc-item sub" data-slug={h2.slug} title={h2.text}>
                      <span class="toc-hash">#</span>
                      <span class="text-truncate">{h2.text}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">Sin subtítulos</p>
    )}
  </div>
</aside>

<!-- 2. BLOQUE INDEPENDIENTE: METADATOS (1/3 INFERIOR) -->
<aside class="independent-panel bottom-meta" id="sec-meta" aria-label="Metadatos">
  <div class="panel-header">METADATOS</div>
  <div class="panel-body meta-scroll-area">
    <div class="meta-row">
      <span class="meta-k">Fecha:</span>
      <span class="meta-v">{frontmatter.date ? new Date(frontmatter.date).toLocaleDateString() : '—'}</span>
    </div>
    
    {frontmatter.author && (
      <div class="meta-row">
        <span class="meta-k">Autor:</span>
        <a href={`/docs/explorar?search=@${frontmatter.author}`} class="meta-v meta-link" title={`Ver más de ${frontmatter.author}`}>
          {frontmatter.author}
        </a>
      </div>
    )}

    {frontmatter.readingTime && (
      <div class="meta-row">
        <span class="meta-k">Lectura:</span>
        <span class="meta-v">{frontmatter.readingTime} min</span>
      </div>
    )}

    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="meta-row tags-row">
        <span class="meta-k">Tags:</span>
        <div class="meta-tags">
          {frontmatter.tags.map((t: string) => (
            <a href={`/docs/explorar?search=%23${t}`} class="tag-pill" title={`Filtrar por #${t}`}>
              #{t}
            </a>
          ))}
        </div>
      </div>
    )}

    {outlinks.length > 0 && (
      <div class="meta-block">
        <span class="meta-k">Enlaces Salientes:</span>
        <ul class="meta-link-list">
          {outlinks.map(link => (
            <li><a href={link.url} class="doc-link-item" title={link.title}>➡️ {link.title}</a></li>
          ))}
        </ul>
      </div>
    )}

    {backlinks.length > 0 && (
      <div class="meta-block">
        <span class="meta-k">Backlinks:</span>
        <ul class="meta-link-list">
          {backlinks.map(bl => (
            <li><a href={bl.url} class="doc-link-item" title={bl.title}>🔗 {bl.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</aside>

<script>
  function setupTocScrollspy() {
    const scrollContainer = document.getElementById('main-scroll-container');
    const tocContainer = document.getElementById('toc-body');
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.r-toc-item'));
    if (!scrollContainer || !tocLinks.length) return;

    const headingPairs = tocLinks
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        const target = slug ? document.getElementById(slug) : null;
        return { link, target, slug };
      })
      .filter((p): p is { link: HTMLAnchorElement; target: HTMLElement; slug: string } => p.target !== null);

    if (!headingPairs.length) return;

    let activeLink: HTMLAnchorElement | null = null;
    let isProgrammaticScroll = false;
    let scrollEndTimer: number | undefined;

    function setActive(item: { link: HTMLAnchorElement; slug: string }, updateHash = true) {
      if (activeLink === item.link) return;

      if (activeLink) activeLink.classList.remove('active-heading');
      item.link.classList.add('active-heading');
      activeLink = item.link;

      if (tocContainer) {
        const linkTop = item.link.offsetTop;
        const containerScroll = tocContainer.scrollTop;
        const containerHeight = tocContainer.clientHeight;
        if (linkTop < containerScroll + 30 || linkTop > containerScroll + containerHeight - 50) {
          tocContainer.scrollTo({ top: linkTop - 50, behavior: 'smooth' });
        }
      }

      if (updateHash && !isProgrammaticScroll) {
        const newHash = `#${item.slug}`;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
        }
      }
    }

    function calculateActiveHeading() {
      if (!scrollContainer || isProgrammaticScroll) return;

      const scrollTop = scrollContainer.scrollTop;
      const scrollHeight = scrollContainer.scrollHeight;
      const clientHeight = scrollContainer.clientHeight;

      if (scrollTop + clientHeight >= scrollHeight - 15) {
        setActive(headingPairs[headingPairs.length - 1], true);
        return;
      }

      const FOCAL_OFFSET = 100;
      let selected = headingPairs[0];

      for (let i = 0; i < headingPairs.length; i++) {
        const distance = headingPairs[i].target.offsetTop - scrollTop;
        if (distance <= FOCAL_OFFSET) {
          selected = headingPairs[i];
        } else {
          break;
        }
      }

      setActive(selected, true);
    }

    let ticking = false;
    scrollContainer.addEventListener('scroll', () => {
      if (isProgrammaticScroll) {
        window.clearTimeout(scrollEndTimer);
        scrollEndTimer = window.setTimeout(() => {
          isProgrammaticScroll = false;
        }, 120);
        return;
      }

      if (!ticking) {
        window.requestAnimationFrame(() => {
          calculateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    headingPairs.forEach((item) => {
      item.link.addEventListener('click', (e) => {
        e.preventDefault();
        isProgrammaticScroll = true;
        window.clearTimeout(scrollEndTimer);
        setActive(item, false);
        history.replaceState(null, '', `#${item.slug}`);

        const targetTop = item.target.offsetTop - 30;
        scrollContainer.scrollTo({
          top: targetTop,
          behavior: 'smooth'
        });

        scrollEndTimer = window.setTimeout(() => {
          isProgrammaticScroll = false;
        }, 600);
      });
    });

    calculateActiveHeading();
  }

  document.addEventListener('astro:page-load', setupTocScrollspy);
</script>

<style>
  .independent-panel {
    position: absolute;
    right: 0;
    width: 260px;
    background: var(--header-bg);
    border-left: 1px solid var(--border-color);
    z-index: 40;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .top-toc {
    top: 0;
    height: 66.666vh;
    border-bottom: 1px solid var(--border-color);
  }

  .bottom-meta {
    bottom: 0;
    height: 33.334vh;
  }

  html.no-toc #sec-toc {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  html.no-meta #sec-meta {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  .panel-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #8b5cf6;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 1rem;
  }

  .meta-scroll-area {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .r-toc-list, .r-toc-nested { list-style: none !important; padding: 0 !important; margin: 0 !important; }
  .r-toc-nested { margin-left: 0.6rem !important; border-left: 1px solid var(--border-color); padding-left: 0.3rem !important; }
  
  .r-toc-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.4rem;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.8rem;
    opacity: 0.65;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  
  .r-toc-item:hover {
    opacity: 1;
    background: rgba(139, 92, 246, 0.12);
    color: #8b5cf6;
  }

  .r-toc-item.active-heading {
    opacity: 1;
    background: rgba(139, 92, 246, 0.18);
    color: #8b5cf6;
    font-weight: 600;
  }

  .toc-hash { color: #8b5cf6; font-size: 0.75rem; font-weight: bold; }
  .text-truncate { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }

  .meta-row { display: flex; justify-content: space-between; font-size: 0.78rem; align-items: center; }
  .meta-k { opacity: 0.6; font-weight: 500; }
  .meta-v { font-weight: 600; color: var(--text-color); }
  .meta-link { color: #a78bfa; text-decoration: none; }
  .meta-link:hover { text-decoration: underline; }

  .tags-row { flex-direction: column; align-items: flex-start; gap: 0.2rem; }
  .meta-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .tag-pill { 
    background: rgba(139, 92, 246, 0.12); 
    color: #8b5cf6; 
    padding: 1px 6px; 
    border-radius: 4px; 
    font-size: 0.7rem; 
    text-decoration: none;
    transition: background 0.15s;
  }
  .tag-pill:hover { background: rgba(139, 92, 246, 0.25); }

  .meta-block { display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.25rem; font-size: 0.78rem; }
  .meta-link-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .doc-link-item { color: #a78bfa; text-decoration: none; font-size: 0.78rem; display: block; opacity: 0.85; transition: opacity 0.15s; }
  .doc-link-item:hover { opacity: 1; text-decoration: underline; }

  .empty-note { font-size: 0.75rem; opacity: 0.5; font-style: italic; margin: 0; }
</style>