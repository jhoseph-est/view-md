---
// src/components/RightSidebar.astro
import { getCollection, type CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
  frontmatter?: any;
}

const { headings = [], frontmatter = {} } = Astro.props;

const allDocs = await getCollection('docs');
const currentPath = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '');

const currentDoc = allDocs.find((doc: CollectionEntry<'docs'>) => {
  const docPath = `/docs/${doc.id.replace(/\\/g, '/')}`;
  return docPath === currentPath;
});

const docBody = currentDoc?.body || '';

function sanitizeBody(rawText: string): string {
  return rawText
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]*?`/g, '')
    .replace(/\$\$[\s\S]*?\$\$/g, '')
    .replace(/\$[^$]*?\$/g, '');
}

const cleanCurrentDocBody = sanitizeBody(docBody);

// 1. Enlaces Salientes (Outlinks)
const outlinks: { title: string; url: string }[] = [];
const seenOutlinks = new Set<string>();

if (cleanCurrentDocBody) {
  const mdLinkRegex = /\[(?:[^\]]+)\]\(([^)#\s]+)(?:#[^)]*)?\)/g;
  const wikiLinkRegex = /\[\[([a-zA-Z0-9_\-\/]+)(?:\Vert{}.*?)?\]\]/g;
  let match: RegExpExecArray | null;

  while ((match = mdLinkRegex.exec(cleanCurrentDocBody)) !== null) {
    const rawTarget = match[1].trim().replace(/\/$/, '');
    const targetUrl = rawTarget.startsWith('/docs/') ? rawTarget : `/docs/${rawTarget}`;
    
    if (targetUrl !== currentPath && !seenOutlinks.has(targetUrl)) {
      const targetDoc = allDocs.find((d: CollectionEntry<'docs'>) => {
        const p = `/docs/${d.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '')}`;
        return p.toLowerCase() === targetUrl.toLowerCase();
      });
      if (targetDoc) {
        seenOutlinks.add(targetUrl);
        outlinks.push({ title: targetDoc.data.title, url: targetUrl });
      }
    }
  }

  while ((match = wikiLinkRegex.exec(cleanCurrentDocBody)) !== null) {
    const cleanSlug = match[1].replace(/\\/g, '/').replace(/^\/docs\//, '').replace(/\/$/, '');
    const targetUrl = `/docs/${cleanSlug}`;
    
    if (targetUrl !== currentPath && !seenOutlinks.has(targetUrl)) {
      const targetDoc = allDocs.find((d: CollectionEntry<'docs'>) => {
        const idPath = d.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '');
        return idPath.toLowerCase() === cleanSlug.toLowerCase() ||
               d.data.title.toLowerCase() === cleanSlug.toLowerCase();
      });
      if (targetDoc) {
        seenOutlinks.add(targetUrl);
        outlinks.push({ title: targetDoc.data.title, url: targetUrl });
      }
    }
  }
}

// 2. Backlinks
const backlinks: { title: string; url: string }[] = [];
const currentCleanSlug = currentPath.replace(/^\/docs\//, '').toLowerCase();
const currentDocTitle = (frontmatter.title || '').trim().toLowerCase();

allDocs.forEach((otherDoc: CollectionEntry<'docs'>) => {
  const otherPath = `/docs/${otherDoc.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '')}`;
  if (otherPath.toLowerCase() === currentPath.toLowerCase() || !otherDoc.body) return;

  const cleanBody = sanitizeBody(otherDoc.body).toLowerCase();
  const hasMarkdownLink = 
    cleanBody.includes(`(/docs/${currentCleanSlug})`) || 
    cleanBody.includes(`(${currentCleanSlug})`);
  const hasWikiLinkBySlug = 
    cleanBody.includes(`[[${currentCleanSlug}]]`) || 
    cleanBody.includes(`[[${currentCleanSlug}|`) ||
    cleanBody.includes(`[[/docs/${currentCleanSlug}]]`) ||
    cleanBody.includes(`[[/docs/${currentCleanSlug}|`);
  const hasWikiLinkByTitle = currentDocTitle ? (
    cleanBody.includes(`[[${currentDocTitle}]]`) || 
    cleanBody.includes(`[[${currentDocTitle}|`)
  ) : false;

  if (hasMarkdownLink || hasWikiLinkBySlug || hasWikiLinkByTitle) {
    backlinks.push({
      title: otherDoc.data.title,
      url: otherPath
    });
  }
});

const allHeadings = headings.filter((h: Heading) => Boolean(h && h.slug && h.text && h.depth >= 1 && h.depth <= 6));
---

<!-- 1. ÍNDICE (TOP) -->
<aside class="independent-panel top-toc" id="sec-toc" aria-label="Índice de Contenidos">
  <div class="panel-header">ÍNDICE</div>
  <div class="panel-body" id="toc-body">
    {allHeadings.length > 0 ? (
      <ul class="r-toc-list">
        {allHeadings.map((h: Heading) => (
          <li class={`r-toc-entry depth-${h.depth}`}>
            <a href={`#${h.slug}`} class="r-toc-item" data-slug={h.slug} title={h.text}>
              <span class="toc-hash">#</span>
              <span class="text-truncate">{h.text}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">Sin subtítulos</p>
    )}
  </div>
</aside>

<!-- 2. METADATOS (BOTTOM) -->
<aside class="independent-panel bottom-meta" id="sec-meta" aria-label="Metadatos">
  <div class="panel-header">METADATOS</div>
  <div class="panel-body meta-scroll-area">
    <div class="meta-row">
      <span class="meta-k">Fecha:</span>
      <span class="meta-v">{frontmatter.date ? new Date(frontmatter.date).toLocaleDateString() : '—'}</span>
    </div>
    
    {frontmatter.author && (
      <div class="meta-row">
        <span class="meta-k">Autor:</span>
        <a href={`/docs/explorar?search=@${frontmatter.author}`} class="meta-v meta-link" title={`Ver más de ${frontmatter.author}`}>
          {frontmatter.author}
        </a>
      </div>
    )}

    {frontmatter.readingTime && (
      <div class="meta-row">
        <span class="meta-k">Lectura:</span>
        <span class="meta-v">{frontmatter.readingTime} min</span>
      </div>
    )}

    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="meta-row tags-row">
        <span class="meta-k">Tags:</span>
        <div class="meta-tags">
          {frontmatter.tags.map((t: string) => (
            <a href={`/docs/explorar?search=%23${t}`} class="tag-pill" title={`Filtrar por #${t}`}>
              #{t}
            </a>
          ))}
        </div>
      </div>
    )}

    {outlinks.length > 0 && (
      <div class="meta-block">
        <span class="meta-k">Enlaces Salientes:</span>
        <ul class="meta-link-list">
          {outlinks.map(link => (
            <li><a href={link.url} class="doc-link-item" title={link.title}>🔗 {link.title}</a></li>
          ))}
        </ul>
      </div>
    )}

    {backlinks.length > 0 && (
      <div class="meta-block">
        <span class="meta-k">Backlinks:</span>
        <ul class="meta-link-list">
          {backlinks.map(bl => (
            <li><a href={bl.url} class="doc-link-item" title={bl.title}>🔗 {bl.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </div>
</aside>

<script>
  function setupTocScrollspy() {
    const scrollContainer = document.getElementById('main-scroll-container');
    const tocContainer = document.getElementById('toc-body');
    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.r-toc-item'));

    if (!scrollContainer || !tocLinks.length) return;

    const headingPairs = tocLinks
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        const target = slug ? document.getElementById(slug) : null;
        return { link, target, slug };
      })
      .filter((p): p is { link: HTMLAnchorElement; target: HTMLElement; slug: string } => p.target !== null);

    if (!headingPairs.length) return;

    let activeLink: HTMLAnchorElement | null = null;
    let isProgrammaticScroll = false;
    let scrollEndTimer: number | undefined;

    function setActive(item: { link: HTMLAnchorElement; slug: string }, updateHash = true) {
      if (activeLink === item.link) return;
      if (activeLink) activeLink.classList.remove('active-heading');
      item.link.classList.add('active-heading');
      activeLink = item.link;

      if (tocContainer) {
        const linkTop = item.link.offsetTop;
        const containerScroll = tocContainer.scrollTop;
        const containerHeight = tocContainer.clientHeight;
        if (linkTop < containerScroll + 30 || linkTop > containerScroll + containerHeight - 50) {
          tocContainer.scrollTo({ top: linkTop - 50, behavior: 'smooth' });
        }
      }

      if (updateHash && !isProgrammaticScroll) {
        const newHash = `#${item.slug}`;
        if (window.location.hash !== newHash) {
          history.replaceState(null, '', newHash);
        }
      }
    }

    function calculateActiveHeading() {
      if (!scrollContainer || isProgrammaticScroll) return;
      const scrollTop = scrollContainer.scrollTop;
      const scrollHeight = scrollContainer.scrollHeight;
      const clientHeight = scrollContainer.clientHeight;

      if (scrollTop + clientHeight >= scrollHeight - 15) {
        setActive(headingPairs[headingPairs.length - 1], true);
        return;
      }

      const FOCAL_OFFSET = 100;
      let selected = headingPairs[0];
      for (let i = 0; i < headingPairs.length; i++) {
        const distance = headingPairs[i].target.offsetTop - scrollTop;
        if (distance <= FOCAL_OFFSET) {
          selected = headingPairs[i];
        } else {
          break;
        }
      }
      setActive(selected, true);
    }

    let ticking = false;
    scrollContainer.addEventListener('scroll', () => {
      if (isProgrammaticScroll) {
        window.clearTimeout(scrollEndTimer);
        scrollEndTimer = window.setTimeout(() => {
          isProgrammaticScroll = false;
        }, 120);
        return;
      }
      if (!ticking) {
        window.requestAnimationFrame(() => {
          calculateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    headingPairs.forEach((item) => {
      item.link.addEventListener('click', (e) => {
        e.preventDefault();
        isProgrammaticScroll = true;
        window.clearTimeout(scrollEndTimer);
        setActive(item, false);
        history.replaceState(null, '', `#${item.slug}`);

        const targetTop = item.target.offsetTop - 30;
        scrollContainer.scrollTo({
          top: targetTop,
          behavior: 'smooth'
        });

        scrollEndTimer = window.setTimeout(() => {
          isProgrammaticScroll = false;
        }, 600);
      });
    });

    calculateActiveHeading();
  }

  document.addEventListener('astro:page-load', setupTocScrollspy);
</script>

<style is:global>
  /* Reset estricto de listas dentro de los paneles laterales */
  .independent-panel ul,
  .independent-panel ol {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .independent-panel li {
    list-style: none !important;
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .independent-panel a {
    text-decoration: none !important;
  }
</style>

<style>
  .independent-panel {
    position: absolute;
    right: 0;
    width: 260px;
    background: var(--header-bg);
    border-left: 1px solid var(--border-color);
    z-index: 40;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .top-toc {
    top: 0;
    height: 66.666vh;
    border-bottom: 1px solid var(--border-color);
  }

  .bottom-meta {
    bottom: 0;
    height: 33.334vh;
  }

  :global(html.no-toc) #sec-toc {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  :global(html.no-meta) #sec-meta {
    transform: translateX(100%);
    opacity: 0;
    pointer-events: none;
  }

  .panel-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent-color, #8b5cf6);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .panel-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 1rem;
    box-sizing: border-box;
  }

  .meta-scroll-area {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .r-toc-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .r-toc-entry {
    list-style: none !important;
    margin: 0.15rem 0 !important;
  }

  /* Sangrías y jerarquía visual del H1 al H6 */
  .r-toc-entry.depth-1 { padding-left: 0; font-weight: 600; }
  .r-toc-entry.depth-2 { padding-left: 0.6rem; }
  .r-toc-entry.depth-3 { padding-left: 1.1rem; opacity: 0.9; }
  .r-toc-entry.depth-4 { padding-left: 1.6rem; opacity: 0.85; font-size: 0.78rem; }
  .r-toc-entry.depth-5 { padding-left: 2.1rem; opacity: 0.8; font-size: 0.75rem; }
  .r-toc-entry.depth-6 { padding-left: 2.6rem; opacity: 0.75; font-size: 0.72rem; }

  .r-toc-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.5rem;
    color: var(--text-color);
    text-decoration: none !important;
    font-size: 0.8rem;
    opacity: 0.7;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .r-toc-item:hover {
    opacity: 1;
    background: var(--accent-subtle, rgba(139, 92, 246, 0.12));
    color: var(--accent-color, #8b5cf6);
  }

  .r-toc-item.active-heading {
    opacity: 1;
    background: var(--accent-subtle, rgba(139, 92, 246, 0.22)) !important;
    color: var(--accent-color, #8b5cf6) !important;
    font-weight: 600;
  }

  .toc-hash { 
    color: var(--accent-color, #8b5cf6); 
    font-size: 0.75rem; 
    font-weight: bold; 
    flex-shrink: 0;
  }

  .text-truncate { 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    flex: 1; 
  }

  .meta-row { 
    display: flex; 
    justify-content: space-between; 
    font-size: 0.78rem; 
    align-items: center; 
  }

  .meta-k { 
    opacity: 0.6; 
    font-weight: 500; 
  }

  .meta-v { 
    font-weight: 600; 
    color: var(--text-color); 
  }

  .meta-link { 
    color: var(--accent-color, #a78bfa); 
    text-decoration: none !important; 
  }
  .meta-link:hover { text-decoration: underline !important; }

  .tags-row { 
    flex-direction: column; 
    align-items: flex-start; 
    gap: 0.3rem; 
  }

  .meta-tags { 
    display: flex; 
    flex-wrap: wrap; 
    gap: 5px; 
  }

  .tag-pill {
    background: var(--accent-subtle, rgba(139, 92, 246, 0.15));
    color: var(--accent-color, #8b5cf6);
    padding: 2px 7px;
    border-radius: 4px;
    font-size: 0.7rem;
    text-decoration: none !important;
    transition: background 0.15s;
  }
  .tag-pill:hover { 
    background: var(--accent-border, rgba(139, 92, 246, 0.3)); 
  }

  .meta-block { 
    display: flex; 
    flex-direction: column; 
    gap: 0.2rem; 
    margin-top: 0.25rem; 
    font-size: 0.78rem; 
  }

  .meta-link-list { 
    list-style: none !important; 
    padding: 0 !important; 
    margin: 0 !important; 
    display: flex; 
    flex-direction: column; 
    gap: 0.15rem; 
  }

  .doc-link-item { 
    color: var(--accent-color, #a78bfa); 
    text-decoration: none !important; 
    font-size: 0.78rem; 
    display: block; 
    opacity: 0.85; 
    transition: opacity 0.15s; 
  }
  .doc-link-item:hover { 
    opacity: 1; 
    text-decoration: underline !important; 
  }

  .empty-note { 
    font-size: 0.75rem; 
    opacity: 0.5; 
    font-style: italic; 
    margin: 0; 
  }
</style>