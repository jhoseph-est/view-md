---
// src/components/FolderView.astro
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatName } from '../utils/fileTree';

interface Props {
  linkVolver: string;
  textoVolver: string;
  folderPath: string;
  folderName: string;
  subfolders?: string[];
  directFiles?: CollectionEntry<'docs'>[];
}

const {
  linkVolver,
  textoVolver,
  folderPath,
  folderName,
  subfolders = [],
  directFiles = []
} = Astro.props;

// Cuando estamos en explorar, obtenemos todos los documentos de la colección para búsqueda global
const isGlobalExplorar = folderPath === 'explorar';
const allDocs = isGlobalExplorar ? await getCollection('docs') : [];
const globalFiles = allDocs.filter((d: CollectionEntry<'docs'>) => d.data.draft !== true);

// Lista a procesar en el cliente (global si es explorar, local si es una subcarpeta específica)
const filesToProcess = isGlobalExplorar ? globalFiles : directFiles;

// Serialización liviana para el motor de filtrado del cliente
const serializedFiles = filesToProcess.map((file: CollectionEntry<'docs'>) => {
  const cleanSlug = file.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '');
  return {
    slug: cleanSlug,
    title: file.data.title || file.id.split('/').pop() || '',
    author: String(file.data.author || '').toLowerCase(),
    tags: Array.isArray(file.data.tags) ? file.data.tags.map((t: string) => String(t).toLowerCase()) : []
  };
});
---

<div class="folder-view" id="folder-view-container">
  <a href={linkVolver} class="back-link" id="back-link-btn">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    Volver a <span>{textoVolver}</span>
  </a>
  
  <div class="folder-header">
    <span class="folder-icon-large">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
      </svg>
    </span>
    <h1 id="folder-title-text">{folderPath === 'explorar' ? 'Directorio Principal' : formatName(folderName)}</h1>
  </div>
         
  <p class="folder-desc" id="folder-desc-text">
    {isGlobalExplorar ? 'Directorio general de todos los documentos y notas.' : 'Explora los documentos y secciones dentro de esta carpeta.'}
  </p>
         
  <div class="folder-grid" id="folder-items-grid">
    <!-- Subcarpetas existentes -->
    {subfolders.map((sub: string) => {
      const folderSlug = sub.split('/').pop() || '';
      return (
        <a href={`/docs/${sub}`} class="folder-card folder-node" data-name={folderSlug.toLowerCase()}>
          <span class="icon folder-svg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/>
            </svg>
          </span>
          <span class="name">{formatName(folderSlug)}</span>
        </a>
      );
    })}

    <!-- Archivos directos iniciales sin sentencias de bloque dentro del JSX -->
    {directFiles.map((file: CollectionEntry<'docs'>) => (
      <a 
        href={`/docs/${file.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '')}`} 
        class="folder-card file-node" 
        data-slug={file.id.replace(/\\/g, '/').replace(/\.(md|mdx)$/, '')}
        data-title={(file.data.title || '').toLowerCase()}
        data-author={String(file.data.author || '').toLowerCase()}
        data-tags={JSON.stringify(file.data.tags || []).toLowerCase()}
      >
        <span class="icon file-svg">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <line x1="10" y1="9" x2="8" y2="9"/>
          </svg>
        </span>
        <span class="name">{file.data.title}</span>
      </a>
    ))}
  </div>

  <p id="no-results-msg" class="no-results" style="display: none;">No se encontraron documentos coincidentes con la búsqueda.</p>
</div>

<script define:vars={{ serializedFiles, isGlobalExplorar }}>
  function applyQueryFilter() {
    const params = new URLSearchParams(window.location.search);
    const searchQuery = params.get('search');
    
    const titleEl = document.getElementById('folder-title-text');
    const descEl = document.getElementById('folder-desc-text');
    const itemsGrid = document.getElementById('folder-items-grid');
    const noResultsMsg = document.getElementById('no-results-msg');

    if (!itemsGrid) return;

    // Si no hay parámetro de búsqueda, restaurar estado original
    if (!searchQuery || !searchQuery.trim()) {
      const folderCards = itemsGrid.querySelectorAll('.folder-node');
      for (let i = 0; i < folderCards.length; i++) {
        folderCards[i].style.display = 'flex';
      }
      const fileCards = itemsGrid.querySelectorAll('.file-node');
      for (let i = 0; i < fileCards.length; i++) {
        fileCards[i].style.display = 'flex';
      }
      if (noResultsMsg) noResultsMsg.style.display = 'none';
      return;
    }

    // Decodificar completamente (soporta %23, %40 y caracteres directos)
    const rawDecoded = decodeURIComponent(searchQuery).trim();
    const query = rawDecoded.toLowerCase();

    if (titleEl) titleEl.textContent = 'Resultados para: "' + rawDecoded + '"';
    if (descEl) descEl.textContent = isGlobalExplorar
      ? 'Búsqueda global en toda la base de conocimiento.'
      : 'Filtrado activo en el directorio actual.';

    // Determinar modo de búsqueda
    const isTagSearch = query.startsWith('#');
    const isAuthorSearch = query.startsWith('@');
    const cleanTerm = query.replace(/^[#@]/, '').trim();

    // En búsquedas por etiqueta o autor, ocultar siempre las carpetas
    const folderCards = itemsGrid.querySelectorAll('.folder-node');
    for (let i = 0; i < folderCards.length; i++) {
      folderCards[i].style.display = 'none';
    }

    let matchedDocs = [];

    if (isTagSearch) {
      matchedDocs = serializedFiles.filter(function (d) {
        return d.tags.some(function (t) { return t.indexOf(cleanTerm) !== -1; });
      });
    } else if (isAuthorSearch) {
      matchedDocs = serializedFiles.filter(function (d) {
        return d.author.indexOf(cleanTerm) !== -1;
      });
    } else {
      matchedDocs = serializedFiles.filter(function (d) {
        return d.title.toLowerCase().indexOf(cleanTerm) !== -1 ||
               d.tags.some(function (t) { return t.indexOf(cleanTerm) !== -1; }) ||
               d.author.indexOf(cleanTerm) !== -1;
      });
    }

    // En búsqueda global sobre explorar, reinyectar las tarjetas de los resultados
    if (isGlobalExplorar) {
      itemsGrid.innerHTML = '';
      matchedDocs.forEach(function (doc) {
        const card = document.createElement('a');
        card.href = '/docs/' + doc.slug;
        card.className = 'folder-card file-node';
        card.innerHTML = 
          '<span class="icon file-svg">' +
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
              '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>' +
              '<polyline points="14 2 14 8 20 8"/>' +
              '<line x1="16" y1="13" x2="8" y2="13"/>' +
              '<line x1="16" y1="17" x2="8" y2="17"/>' +
              '<line x1="10" y1="9" x2="8" y2="9"/>' +
            '</svg>' +
          '</span>' +
          '<span class="name">' + doc.title + '</span>';
        itemsGrid.appendChild(card);
      });
    } else {
      // Filtrado in-place en subcarpetas
      const fileCards = itemsGrid.querySelectorAll('.file-node');
      fileCards.forEach(function (file) {
        const fileSlug = file.getAttribute('data-slug') || '';
        const isMatch = matchedDocs.some(function (m) { return m.slug === fileSlug; });
        file.style.display = isMatch ? 'flex' : 'none';
      });
    }

    if (noResultsMsg) {
      noResultsMsg.style.display = matchedDocs.length === 0 ? 'block' : 'none';
    }
  }

  applyQueryFilter();
  document.addEventListener('astro:page-load', applyQueryFilter);
</script>