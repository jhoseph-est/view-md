---
// src/components/ModalImpresion.astro
import estilosData from '../config/estilos-base.json';
---

<div class="print-modal-overlay" id="print-modal-overlay" aria-hidden="true">
  <div class="print-modal-card">
    <div class="print-modal-header">
      <div>
        <h3>Impresión Rápida de Apunte</h3>
        <p>Ajuste de formato de página y márgenes de lectura</p>
      </div>
      <button type="button" class="btn-close-print-modal" id="btn-close-print-modal">&times;</button>
    </div>

    <div class="print-modal-body">
      <!-- Formato de Hoja y Estilo Visual -->
      <div class="print-grid-2">
        <div class="print-field-group">
          <label for="p-formato">Tamaño de Hoja</label>
          <select id="p-formato" class="print-select">
            <option value="A4" selected>A4 (210 x 297 mm)</option>
            <option value="Carta">Carta / Letter</option>
          </select>
        </div>

        <div class="print-field-group">
          <label for="p-estilo">Estilo Visual</label>
          <select id="p-estilo" class="print-select">
            {Object.entries(estilosData).map(([key, val]: any) => (
              <option value={key}>{val.nombre || key}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Márgenes -->
      <div class="print-grid-2">
        <div class="print-field-group">
          <label for="p-margen-sup">Margen Superior / Inferior</label>
          <select id="p-margen-sup" class="print-select">
            <option value="2.54cm">Normal (2.54 cm / APA)</option>
            <option value="1.8cm" selected>Moderado (1.8 cm)</option>
            <option value="1.2cm">Estrecho (1.2 cm)</option>
          </select>
        </div>

        <div class="print-field-group">
          <label for="p-margen-lat">Margen Lateral</label>
          <select id="p-margen-lat" class="print-select">
            <option value="2.54cm">Normal (2.54 cm)</option>
            <option value="1.8cm" selected>Moderado (1.8 cm)</option>
            <option value="1.2cm">Estrecho (1.2 cm)</option>
          </select>
        </div>
      </div>
    </div>

    <div class="print-modal-footer">
      <button type="button" class="btn-cancel-print" id="btn-cancel-print">Cancelar</button>
      <button type="button" class="btn-confirm-print" id="btn-confirm-print">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span>Imprimir Apunte</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { ejecutarImpresionAislada } from '../utils/printDoc';

  function initPrintModal() {
    const modal = document.getElementById('print-modal-overlay');
    const btnClose = document.getElementById('btn-close-print-modal');
    const btnCancel = document.getElementById('btn-cancel-print');
    const btnConfirm = document.getElementById('btn-confirm-print');

    function toggleModal(open: boolean) {
      if (!modal) return;
      if (open) {
        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
      } else {
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
      }
    }

    const handleOpenModal = () => toggleModal(true);
    
    window.removeEventListener('open-print-modal', handleOpenModal);
    window.addEventListener('open-print-modal', handleOpenModal);

    // Cerrar con Escape
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal?.classList.contains('is-active')) {
        toggleModal(false);
      }
    };
    document.removeEventListener('keydown', handleKeyDown);
    document.addEventListener('keydown', handleKeyDown);

    if (btnClose) btnClose.onclick = () => toggleModal(false);
    if (btnCancel) btnCancel.onclick = () => toggleModal(false);
    
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) toggleModal(false);
      };
    }

    if (btnConfirm) {
      btnConfirm.onclick = async () => {
        const estiloId = (document.getElementById('p-estilo') as HTMLSelectElement)?.value || 'default';
        const formatoHoja = ((document.getElementById('p-formato') as HTMLSelectElement)?.value || 'A4') as 'A4' | 'Carta';
        const margenVert = (document.getElementById('p-margen-sup') as HTMLSelectElement)?.value || '1.8cm';
        const margenLat = (document.getElementById('p-margen-lat') as HTMLSelectElement)?.value || '1.8cm';

        toggleModal(false);

        await ejecutarImpresionAislada({
          estiloId,
          formatoHoja,
          margenSuperior: margenVert,
          margenInferior: margenVert,
          margenLateral: margenLat
        });
      };
    }
  }

  document.addEventListener('astro:page-load', initPrintModal);
  initPrintModal();
</script>